import { Button, ComboBox, LineEdit } from "std-widgets.slint";
component Field inherits LineEdit {
    public function edit-key(code:int) {
        if code==0 {self.select-all();} else if code==1 {self.copy();} else if code==2 {self.cut();}
        else if code==3 {self.paste();} else if code==4 {self.undo();} else if code==5 {self.redo();}
    }
}
export component BookmarksWindow inherits Window {
    title:root.labels[0];preferred-width:1000px;preferred-height:760px;min-width:640px;min-height:540px;background:#171b23;
    in property <[string]> labels;
    in property <[string]> entries;
    in property <string> message;
    in property <bool> writable;
    in property <bool> busy;
    in property <bool> composing;
    in property <bool> selected;
    in property <bool> has-copy;
    in property <bool> go-ready;
    in property <bool> offline;
    in property <image> page;
    in property <string> progress;
    in-out property <int> choice:0;
    in-out property <string> target;
    in-out property <string> label;
    out property <float> reader-width:reader.width/1px;
    out property <float> reader-height:reader.height/1px;
    changed reader-width=>{root.reader-resized();}
    changed reader-height=>{root.reader-resized();}
    callback reader-resized;
    callback choose(int);
    callback new-entry;
    callback action(int);
    callback close-bookmarks;
    callback page-key(int);
    callback field-edit(int,string)->string;
    public function edit-key(code:int)->bool {
        if root.offline {return false;}
        if target-field.has-focus {target-field.edit-key(code);return true;}
        if label-field.has-focus {label-field.edit-key(code);return true;}
        return false;
    }
    public function focus-target() {target-field.focus();}
    public function focus-reader() {reader-keys.focus();}
    FocusScope {
        visible:!root.offline;
        key-pressed(event)=>{if event.text==Key.Escape && !root.composing {root.close-bookmarks();return accept;}return reject;}
        VerticalLayout {padding:16px;spacing:10px;
            Text {text:root.labels[1];color:#c7d4e7;wrap:word-wrap;}
            Text {text:root.labels[2];color:#c7d4e7;}
            ComboBox {model:root.entries;current-index<=>root.choice;enabled:!root.busy && !root.composing;selected=>{root.choose(self.current-index);}}
            Button {text:root.labels[3];enabled:!root.busy && !root.composing;clicked=>{root.new-entry();}}
            Text {text:root.labels[4];color:#c7d4e7;}
            target-field:=Field {text<=>root.target;accessible-label:root.labels[4];enabled:!root.busy;edited=>{self.text=root.field-edit(0,self.text);}}
            Text {text:root.labels[5];color:#c7d4e7;}
            label-field:=Field {text<=>root.label;accessible-label:root.labels[5];enabled:!root.busy;edited=>{self.text=root.field-edit(1,self.text);}}
            HorizontalLayout {
                Button {text:root.labels[6];enabled:root.writable && !root.busy && !root.composing;clicked=>{root.action(0);}}
                Button {text:root.labels[7];enabled:root.writable && root.selected && !root.busy && !root.composing;clicked=>{root.action(1);}}
                Button {text:root.labels[8];enabled:root.has-copy && !root.busy && !root.composing;clicked=>{root.action(2);}}
                Button {text:root.labels[14];enabled:root.go-ready && root.selected && !root.busy && !root.composing;clicked=>{root.action(4);}}
            }
            Text {text:root.message;color:#f2cd7d;wrap:word-wrap;vertical-stretch:1;}
            HorizontalLayout {
                Button {text:root.labels[9];enabled:!root.busy && !root.composing;clicked=>{root.action(3);}}
                Button {text:root.labels[10];enabled:!root.composing;clicked=>{root.close-bookmarks();}}
            }
        }
    }
    reader-keys:=FocusScope {
        visible:root.offline;
        key-pressed(event)=>{
            if event.text==Key.Escape {root.page-key(6);return accept;}
            if event.text==Key.UpArrow {root.page-key(0);return accept;}
            if event.text==Key.DownArrow {root.page-key(1);return accept;}
            if event.text==Key.PageUp {root.page-key(2);return accept;}
            if event.text==Key.PageDown || event.text==" " {root.page-key(3);return accept;}
            if event.text==Key.Home {root.page-key(4);return accept;}
            if event.text==Key.End {root.page-key(5);return accept;}
            return reject;
        }
        VerticalLayout {padding:12px;spacing:8px;
            Text {text:root.labels[11];color:#f2cd7d;wrap:word-wrap;}
            reader:=Rectangle {background:black;vertical-stretch:1;
                Image {source:root.page;image-fit:contain;}
                TouchArea {
                    clicked=>{reader-keys.focus();}
                    scroll-event(event)=>{if event.delta-y!=0px {root.page-key(event.delta-y>0px?0:1);}return accept;}
                }
            }
            Text {text:root.progress;color:#c7d4e7;}
            HorizontalLayout {
                Button {text:root.labels[12];clicked=>{root.page-key(2);}}
                Button {text:root.labels[13];clicked=>{root.page-key(3);}}
                Button {text:root.labels[10];clicked=>{root.page-key(6);}}
            }
        }
    }
}
