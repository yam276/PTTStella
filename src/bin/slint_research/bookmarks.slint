import { ScrollView } from "std-widgets.slint";
import { PanelButton, PanelField, PanelCombo, PanelOverlay } from "panel.slint";

export global BookmarksState {
    in-out property <[string]> labels;
    in-out property <[string]> entries;
    in-out property <string> message;
    in-out property <bool> writable;
    in-out property <bool> busy;
    in-out property <bool> composing;
    in-out property <bool> selected;
    in-out property <bool> has-copy;
    in-out property <bool> go-ready;
    in-out property <bool> offline;
    in-out property <image> page;
    in-out property <string> progress;
    in-out property <int> choice:0;
    in-out property <string> target;
    in-out property <string> label;
    in-out property <float> reader-width;
    in-out property <float> reader-height;
    callback reader-resized;
    callback choose(int);
    callback new-entry;
    callback action(int);
    callback close-bookmarks;
    callback page-key(int);
    callback field-edit(int,string)->string;
    in-out property <int> focus-target-sequence;
    public function focus-target() { root.focus-target-sequence += 1; }
    in-out property <int> focus-reader-sequence;
    public function focus-reader() { root.focus-reader-sequence += 1; }
}

export component BookmarksPanel inherits PanelOverlay {
    heading: BookmarksState.labels[0];
    panel-width: 900px; panel-height: 700px;
    private property <int> focus-target-sequence: BookmarksState.focus-target-sequence;
    changed focus-target-sequence => { target-field.focus(); }
    private property <int> focus-reader-sequence: BookmarksState.focus-reader-sequence;
    changed focus-reader-sequence => { reader-keys.focus(); }
    private property <float> reader-width: reader.width / 1px;
    private property <float> reader-height: reader.height / 1px;
    changed reader-width => { BookmarksState.reader-width = self.reader-width; BookmarksState.reader-resized(); }
    changed reader-height => { BookmarksState.reader-height = self.reader-height; BookmarksState.reader-resized(); }
    FocusScope {
        visible:!BookmarksState.offline;
        key-pressed(event)=>{if event.text==Key.Escape && !BookmarksState.composing {BookmarksState.close-bookmarks();return accept;}return reject;}
        ScrollView {
            content-width: self.width;
        VerticalLayout {alignment: start; padding:16px;spacing:10px;
            Text {text:BookmarksState.labels[1];color:#c7d4e7;wrap:word-wrap;}
            Text {text:BookmarksState.labels[2];color:#c7d4e7;}
            PanelCombo {model:BookmarksState.entries;current-index<=>BookmarksState.choice;enabled:!BookmarksState.busy && !BookmarksState.composing;selected=>{BookmarksState.choose(self.current-index);}}
            PanelButton {text:BookmarksState.labels[3];enabled:!BookmarksState.busy && !BookmarksState.composing;clicked=>{BookmarksState.new-entry();}}
            Text {text:BookmarksState.labels[4];color:#c7d4e7;}
            target-field:=PanelField {text<=>BookmarksState.target;accessible-label:BookmarksState.labels[4];enabled:!BookmarksState.busy;edited=>{self.text=BookmarksState.field-edit(0,self.text);}}
            Text {text:BookmarksState.labels[5];color:#c7d4e7;}
            label-field:=PanelField {text<=>BookmarksState.label;accessible-label:BookmarksState.labels[5];enabled:!BookmarksState.busy;edited=>{self.text=BookmarksState.field-edit(1,self.text);}}
            HorizontalLayout {
                PanelButton {text:BookmarksState.labels[6];enabled:BookmarksState.writable && !BookmarksState.busy && !BookmarksState.composing;clicked=>{BookmarksState.action(0);}}
                PanelButton {text:BookmarksState.labels[7];enabled:BookmarksState.writable && BookmarksState.selected && !BookmarksState.busy && !BookmarksState.composing;clicked=>{BookmarksState.action(1);}}
                PanelButton {text:BookmarksState.labels[8];enabled:BookmarksState.has-copy && !BookmarksState.busy && !BookmarksState.composing;clicked=>{BookmarksState.action(2);}}
                PanelButton {text:BookmarksState.labels[14];enabled:BookmarksState.go-ready && BookmarksState.selected && !BookmarksState.busy && !BookmarksState.composing;clicked=>{BookmarksState.action(4);}}
            }
            Text {text:BookmarksState.message;color:#f2cd7d;wrap:word-wrap;vertical-stretch:1;}
            HorizontalLayout {
                PanelButton {text:BookmarksState.labels[9];enabled:!BookmarksState.busy && !BookmarksState.composing;clicked=>{BookmarksState.action(3);}}
                PanelButton {text:BookmarksState.labels[10];enabled:!BookmarksState.composing;clicked=>{BookmarksState.close-bookmarks();}}
            }
        }
        }
    }
    reader-keys:=FocusScope {
        visible:BookmarksState.offline;
        key-pressed(event)=>{
            if event.text==Key.Escape {BookmarksState.page-key(6);return accept;}
            if event.text==Key.UpArrow {BookmarksState.page-key(0);return accept;}
            if event.text==Key.DownArrow {BookmarksState.page-key(1);return accept;}
            if event.text==Key.PageUp {BookmarksState.page-key(2);return accept;}
            if event.text==Key.PageDown || event.text==" " {BookmarksState.page-key(3);return accept;}
            if event.text==Key.Home {BookmarksState.page-key(4);return accept;}
            if event.text==Key.End {BookmarksState.page-key(5);return accept;}
            return reject;
        }
        VerticalLayout {padding:12px;spacing:8px;
            Text {text:BookmarksState.labels[11];color:#f2cd7d;wrap:word-wrap;}
            reader:=Rectangle {background:black;vertical-stretch:1;
                Image {source:BookmarksState.page;image-fit:contain;}
                TouchArea {
                    clicked=>{reader-keys.focus();}
                    scroll-event(event)=>{if event.delta-y!=0px {BookmarksState.page-key(event.delta-y>0px?0:1);}return accept;}
                }
            }
            Text {text:BookmarksState.progress;color:#c7d4e7;}
            HorizontalLayout {
                PanelButton {text:BookmarksState.labels[12];clicked=>{BookmarksState.page-key(2);}}
                PanelButton {text:BookmarksState.labels[13];clicked=>{BookmarksState.page-key(3);}}
                PanelButton {text:BookmarksState.labels[10];clicked=>{BookmarksState.page-key(6);}}
            }
        }
    }
}
