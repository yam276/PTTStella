import {Button,ComboBox,LineEdit} from "std-widgets.slint";
component Field inherits LineEdit {
    public function edit-key(code:int) {
        if code==0 {self.select-all();} else if code==1 {self.copy();} else if code==2 {self.cut();}
        else if code==3 {self.paste();} else if code==4 {self.undo();} else if code==5 {self.redo();}
    }
}
export component DestinationWindow inherits Window {
    title:root.labels[0];preferred-width:700px;preferred-height:430px;min-width:520px;min-height:380px;background:#171b23;
    in property <[string]> labels;
    in property <[string]> boards;
    in property <bool> busy;
    in property <bool> active;
    in property <bool> composing;
    in property <string> message;
    in property <string> history-message;
    in-out property <string> draft;
    in-out property <int> choice:0;
    callback choose(int);
    callback field-edit(string)->string;
    callback action(int);
    callback close-destination;
    public function edit-key(code:int)->bool {if input.has-focus {input.edit-key(code);return true;}return false;}
    public function focus-draft(){input.focus();}
    FocusScope {
        key-pressed(event)=>{
            if event.text==Key.Escape && !root.composing && !event.repeat {root.close-destination();return accept;}
            if event.text==Key.Return && !root.composing && !event.repeat && !root.busy {root.action(0);return accept;}
            return reject;
        }
        VerticalLayout {padding:16px;spacing:10px;
            Text {text:root.labels[1];color:#c7d4e7;}
            input:=Field {text<=>root.draft;accessible-label:root.labels[1];enabled:!root.busy;edited=>{self.text=root.field-edit(self.text);}accepted=>{if !root.composing && !root.busy {root.action(0);}}}
            Text {text:root.labels[2];color:#9ab5ce;wrap:word-wrap;}
            Text {text:root.labels[3];color:#c7d4e7;}
            ComboBox {model:root.boards;current-index<=>root.choice;enabled:!root.busy && !root.composing;selected=>{root.choose(self.current-index);}}
            Text {text:root.history-message;color:#9ab5ce;wrap:word-wrap;}
            Button {text:root.labels[4];enabled:!root.composing;clicked=>{root.action(2);}}
            Text {text:root.message;color:#f2cd7d;wrap:word-wrap;vertical-stretch:1;}
            HorizontalLayout {
                Button {text:root.labels[5];enabled:!root.busy && !root.composing && root.draft!="";clicked=>{root.action(0);}}
                Button {text:root.labels[6];enabled:root.active && !root.composing;clicked=>{root.action(1);}}
                Button {text:root.labels[7];enabled:!root.composing;clicked=>{root.close-destination();}}
            }
        }
    }
}
