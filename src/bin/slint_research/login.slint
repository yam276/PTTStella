import { PanelButton, PanelCheck, PanelField, PanelOverlay } from "panel.slint";

export component LoginPanel inherits PanelOverlay {
    panel-width: 550px;
    panel-height: 405px;
    heading: root.title;
    in property <string> title;
    in property <string> account-label;
    in property <string> password-label;
    in property <string> remember-label;
    in property <string> forget-label;
    in property <string> submit-label;
    in property <string> cancel-label;
    in property <string> message;
    in-out property <string> account;
    in-out property <string> password;
    in-out property <bool> remember;
    in property <bool> busy;
    in property <bool> saved;
    in property <bool> composing;
    callback submit(string, string, bool);
    callback cancel;
    callback forget;
    callback limit-text(string, int) -> string;
    forward-focus: account-field;

    FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (!root.embedded && event.text == Key.Escape && !root.composing && !event.repeat) {
                root.cancel();
                return accept;
            }
            return reject;
        }
            VerticalLayout {
                padding: root.embedded ? 0px : 16px;
                spacing: 12px;
                Text { text: root.account-label; color: #e3e8ee; }
                account-field := PanelField {
                    text <=> root.account;
                    accessible-label: root.account-label;
                    enabled: !root.busy;
                    input-method-hints: { capitalization: none, auto-correct: false, auto-complete: false };
                    edited(text) => { self.text = root.limit-text(text, 12); }
                }
                Text { text: root.password-label; color: #e3e8ee; }
                password-field := PanelField {
                    text <=> root.password;
                    input-type: InputType.password;
                    accessible-label: root.password-label;
                    enabled: !root.busy;
                    input-method-hints: { capitalization: none, auto-correct: false, auto-complete: false };
                    edited(text) => { self.text = root.limit-text(text, 72); }
                    accepted => {
                        if (!root.busy && !root.composing) {
                            root.submit(account-field.text, self.text, remember.checked);
                            self.text = "";
                        }
                    }
                }
                remember  := PanelCheck { checked <=> root.remember; caption: root.remember-label; enabled: !root.busy; }
                Text { text: root.message; color: #b7c1ce; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    PanelButton { text: root.forget-label; enabled: !root.busy && !root.composing && root.saved; clicked => { root.forget(); } }
                    if !root.embedded: PanelButton { text: root.cancel-label; clicked => { root.cancel(); } }
                    PanelButton {
                        text: root.submit-label; primary: true;
                        enabled: !root.busy && !root.composing;
                        clicked => {
                            root.submit(account-field.text, password-field.text, remember.checked);
                            password-field.text = "";
                        }
                    }
                }
            }
    }
}
