import {Button, Slider} from "std-widgets.slint";
import {ContextMenuOverlay} from "context-menu.slint";
export component MediaPreview inherits Rectangle {
    in property <image> pixels;
    in property <string> source-key;
    in property <string> url;
    in property <string> status;
    in property <bool> ready;
    in property <bool> video;
    in-out property <float> position;
    in property <float> duration;
    out property <length> video-left: view.absolute-position.x;
    out property <length> video-top: view.absolute-position.y;
    out property <length> video-width: view.width;
    out property <length> video-height: view.height;
    callback seek(float);
    in property <bool> busy;
    in property <string> copy-label;
    in property <string> save-label;
    in property <string> copy-url-label;
    in property <bool> animated;
    in property <bool> playing;
    in property <bool> foreground;
    in property <string> close-label;
    in property <string> retry-label;
    in property <string> motion-label;
    in property <string> external-label;
    in property <string> fit-label;
    in property <string> original-label;
    callback action(int);
    callback focus-preview;
    focus-preview => { keys.focus(); }
    property <bool> fit: true;
    property <float> scale: 1;
    property <length> pan-x;
    property <length> pan-y;
    property <length> grab-x;
    property <length> grab-y;
    property <bool> dragging;
    property <bool> menu-open;
    property <int> menu-index;
    property <length> menu-x;
    property <length> menu-y;
    function open-menu(x:length,y:length) {
        if !root.video && !root.busy && root.foreground {
            root.dragging=false;root.menu-x=x;root.menu-y=y;
            root.menu-index=root.ready ? 0 : 2;root.menu-open=true;menu.focus-menu();
        }
    }
    function dismiss-menu() {root.menu-open=false;keys.focus();}
    function choose-menu(index:int) {
        if root.busy || index < 0 || index > 3 || (index < 2 && !root.ready) {return;}
        root.dismiss-menu();root.action(index < 3 ? index + 4 : 3);
    }
    property <float> actual: root.fit ? max(0.01, min(1, min(view.width / max(1px, root.pixels.width * 1px), view.height / max(1px, root.pixels.height * 1px)))) : root.scale;
    changed source-key => { root.fit=true; root.scale=1;root.pan-x=0px;root.pan-y=0px;root.dragging=false;root.menu-open=false; }
    changed foreground => { if !root.foreground {root.dragging=false;root.menu-open=false;} }
    changed width => {root.dragging=false;root.menu-open=false;}
    changed height => {root.dragging=false;root.menu-open=false;}
    changed busy => {if root.busy {root.menu-open=false;}}
    function zoom-by(factor:float,x:length,y:length) {
        let old = root.actual;
        let next = clamp(old * factor,0.01,8);
        root.pan-x = x - view.width / 2 - (x - view.width / 2 - root.pan-x) * next / old;
        root.pan-y = y - view.height / 2 - (y - view.height / 2 - root.pan-y) * next / old;
        root.scale=next;root.fit=false;
    }
    background: #000b;
    TouchArea { clicked => {} }
    keys := FocusScope {
        width:parent.width;height:parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape {root.action(0);return accept;}
            if event.text == Key.F10 && event.modifiers.shift {root.open-menu(root.width/2,root.height/2);return accept;}
            return reject;
        }
        Rectangle {x:12px;y:12px;width:parent.width - 24px;height:parent.height - 24px;background:#202733;border-radius:8px;
            VerticalLayout {padding:12px;spacing:8px;
                Text {text:root.url;color:#cdd9e8;overflow:elide;}
                Text {text:root.status;color:#e9edf4;wrap:word-wrap;}
                view := Rectangle {vertical-stretch:1;min-height:100px;clip:true;background:#080a0e;
                    if !root.video: Image {source:root.pixels;width:root.pixels.width * root.actual * 1px;height:root.pixels.height * root.actual * 1px;
                        x:(parent.width - self.width)/2 + root.pan-x;y:(parent.height - self.height)/2 + root.pan-y;image-fit:fill;}
                    pointer := TouchArea {enabled:!root.video && root.ready && root.foreground;
                        pointer-event(event) => {
                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                root.open-menu(view.x + 12px + self.mouse-x,view.y + 12px + self.mouse-y);
                            }
                            if event.button == PointerEventButton.left {
                                if event.kind == PointerEventKind.down {root.grab-x=self.mouse-x - root.pan-x;root.grab-y=self.mouse-y - root.pan-y;root.dragging=true;}
                                else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {root.dragging=false;}
                            }
                        }
                        moved => {if root.dragging && self.pressed {root.pan-x=self.mouse-x - root.grab-x;root.pan-y=self.mouse-y - root.grab-y;}}
                        scroll-event(event) => {root.zoom-by(event.delta-y > 0px ? 1.1 : 1/1.1,self.mouse-x,self.mouse-y);return accept;}
                    }
                }
                if !root.video: HorizontalLayout {spacing:6px;
                    Button {text:"−";enabled:root.ready;clicked=>{root.zoom-by(1/1.25,view.width/2,view.height/2);}}
                    Button {text:"+";enabled:root.ready;clicked=>{root.zoom-by(1.25,view.width/2,view.height/2);}}
                    Button {text:root.fit-label;enabled:root.ready;clicked=>{root.fit=true;root.pan-x=0px;root.pan-y=0px;}}
                    Button {text:root.original-label;enabled:root.ready;clicked=>{root.fit=false;root.scale=1;root.pan-x=0px;root.pan-y=0px;}}
                    if root.animated: Button {text:root.motion-label;enabled:root.ready;clicked=>{root.action(2);}}
                }
                if root.video: HorizontalLayout {spacing:6px;
                    Button {text:root.motion-label;enabled:root.ready && root.foreground && !root.busy;clicked=>{root.action(2);}}
                    // Keep the shared position binding after a user changes the slider.
                    Slider {minimum:0;maximum:max(1,root.duration);value <=> root.position;enabled:root.duration > 0 && root.foreground && !root.busy;
                        changed(value)=>{root.seek(value);} }
                    Text {text:round(root.position) + " / " + round(root.duration) + " s";color:#cdd9e8;vertical-alignment:center;}
                }
                HorizontalLayout {spacing:6px;
                    if !root.video: Button {text:root.copy-label;enabled:root.ready && !root.busy;clicked=>{root.action(4);}}
                    if !root.video: Button {text:root.save-label;enabled:root.ready && !root.busy;clicked=>{root.action(5);}}
                    Button {text:root.copy-url-label;enabled:!root.busy;clicked=>{root.action(6);}}
                }
                HorizontalLayout {spacing:6px;
                    Button {text:root.retry-label;enabled:!root.busy;clicked=>{root.action(1);}}
                    Button {text:root.external-label;clicked=>{root.action(3);}}
                    Button {text:root.close-label;clicked=>{root.action(0);}}
                }
            }
        }
    }
    menu := ContextMenuOverlay {
        visible:root.menu-open;width:parent.width;height:parent.height;
        entries:[{label:root.copy-label,enabled:root.ready && !root.busy},
            {label:root.save-label,enabled:root.ready && !root.busy},
            {label:root.copy-url-label,enabled:!root.busy},{label:root.external-label,enabled:!root.busy}];
        anchor-x:root.menu-x;anchor-y:root.menu-y;selected:root.menu-index;
        choose(index)=>{root.choose-menu(index);}
        dismiss(consume)=>{root.dismiss-menu();}
        key(kind,repeat)=>{
            if kind == 0 || kind == 1 {root.dismiss-menu();}
            else if kind == 2 {root.menu-index=Math.mod(root.menu-index + 3,4);if !root.ready && root.menu-index < 2 {root.menu-index=3;}}
            else if kind == 3 {root.menu-index=Math.mod(root.menu-index + 1,4);if !root.ready && root.menu-index < 2 {root.menu-index=2;}}
            else if kind == 4 {root.menu-index=root.ready ? 0 : 2;}
            else if kind == 5 {root.menu-index=3;}
            else if kind == 6 && !repeat {root.choose-menu(root.menu-index);}
        }
    }
}
