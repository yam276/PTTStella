import { ListView } from "std-widgets.slint";

export global PanelEdit {
    in-out property <int> code;
    in-out property <int> sequence;
    public function apply(value: int) { root.code = value; root.sequence += 1; }
}

export component PanelButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <length> icon-size: 18px;
    in property <length> font-size: 13px;
    in property <color> label-color: !root.enabled ? #808b99 : root.flat ? #ebe7dc : root.navigation && !root.checked ? #b5bcc7 : #e7c46a;
    in property <color> icon-color: !root.enabled ? #808b99 : #e7c46a;
    in property <bool> checkbox;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    in property <bool> navigation;
    in property <bool> flat;
    in property <bool> primary;
    out property <bool> has-focus: keys.has-focus;
    callback clicked;
    forward-focus: keys;
    min-height: 34px;
    max-height: root.navigation ? 40px : 36px;
    preferred-height: 34px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    min-width: 0px;
    private property <length> inset: root.flat ? 2px : root.navigation ? 16px : 10px;
    private property <length> checkbox-width: root.checkbox ? 20px : 0px;
    private property <length> icon-width: root.icon.width > 0 ? root.icon-size + 8px : 0px;
    preferred-width: label.preferred-width + root.checkbox-width + root.icon-width + 22px;
    background: root.flat ? (root.enabled && touch.has-hover ? #203b55 : transparent)
        : root.checked ? #203b55 : root.navigation && !touch.has-hover ? transparent
        : root.enabled && touch.has-hover ? #203b55 : #132c45;
    border-width: (root.navigation || root.flat) && !root.has-focus ? 0px : 1px;
    border-color: root.enabled && (root.has-focus || touch.has-hover || root.primary) ? #e7c46a : #34475b;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    if root.navigation && root.checked && !root.flat: Rectangle {
        x: 0; y: 0; width: 3px; height: parent.height; background: #e7c46a;
    }
    if root.checkbox: Rectangle {
        x: root.inset; y: (parent.height - self.height) / 2;
        width: 12px; height: 12px; border-radius: 2px;
        border-width: 1px; border-color: #8e98a4;
        background: root.checked ? #bba05d : #132c45;
        if root.checked: Image {
            width: 10px; height: 10px;
            source: @image-url("../../../assets/icons/lucide/check.svg");
        }
    }
    if root.icon-width > 0px: Image {
        x: root.inset + root.checkbox-width;
        y: (parent.height - self.height) / 2;
        width: root.icon-size; height: root.icon-size;
        source: root.icon;
        colorize: root.icon-color;
        accessible-role: none;
    }
    label := Text {
        x: root.inset + root.checkbox-width + root.icon-width;
        width: parent.width - self.x - 10px;
        text: root.text; font-size: root.font-size;
        color: root.label-color;
        vertical-alignment: center;
        horizontal-alignment: root.navigation || root.icon-width > 0px ? left : center;
        overflow: elide;
    }
    touch := TouchArea {
        x: 0; y: 0; width: parent.width; height: parent.height;
        enabled: root.enabled;
        clicked => { keys.focus(); root.clicked(); }
    }
    keys := FocusScope {
        enabled: root.enabled;
        // Let the TouchArea receive the press and assign focus on activation.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                if (!event.repeat) { root.clicked(); }
                return accept;
            }
            return reject;
        }
    }
}

export component PanelCheck inherits PanelButton {
    callback toggled;
    in property <string> caption;
    text: root.caption;
    checkbox: true;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.checked;
    navigation: true;
    clicked => { root.checked = !root.checked; root.toggled(); }
}

export component PanelField inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> placeholder-text;
    in-out property text <=> input.text;
    out property has-focus <=> input.has-focus;
    private property <int> edit-sequence: PanelEdit.sequence;
    changed edit-sequence => { if root.has-focus { root.edit-key(PanelEdit.code); } }
    in property input-type <=> input.input-type;
    in property input-method-hints <=> input.input-method-hints;
    callback edited(string);
    callback accepted <=> input.accepted;
    forward-focus: input;
    min-height: 34px;
    max-height: 36px;
    vertical-stretch: 0;
    min-width: 100px;
    background: #091727;
    border-width: 1px;
    border-color: root.has-focus ? #e7c46a : #34475b;
    accessible-role: text-input;
    accessible-enabled: root.enabled;
    accessible-value: root.input-type == InputType.password ? "" : root.text;
    accessible-placeholder-text: root.placeholder-text;
    accessible-action-set-value(value) => { if (root.enabled) { input.text = value; root.edited(value); } }
    Text {
        x: 10px; width: parent.width - 20px;
        text: root.placeholder-text; visible: root.text == "";
        color: #b5bcc7; font-size: 13px; vertical-alignment: center; overflow: elide;
    }
    input := TextInput {
        x: 10px; width: parent.width - 20px;
        enabled: root.enabled; single-line: true; font-size: 13px;
        color: #ebe7dc; selection-background-color: #e7c46a; selection-foreground-color: #102139;
        vertical-alignment: center;
        edited => { root.edited(self.text); }
    }
    public function select-all() { input.select-all(); }
    public function copy() { input.copy(); }
    public function cut() { input.cut(); }
    public function paste() { input.paste(); }
    public function undo() { input.undo(); }
    public function redo() { input.redo(); }
    public function edit-key(code: int) {
        if code == 0 { input.select-all(); } else if code == 1 { input.copy(); }
        else if code == 2 { input.cut(); } else if code == 3 { input.paste(); }
        else if code == 4 { input.undo(); } else if code == 5 { input.redo(); }
    }
}

export component PanelCombo inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: -1;
    in property <int> displayed-index: root.current-index;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    private property <bool> available: root.enabled && root.model.length > 0;
    private property <length> row-height: 32px;
    private property <int> highlight: -1;
    private property <string> value: root.displayed-index >= 0 && root.displayed-index < root.model.length
        ? root.model[root.displayed-index] : root.placeholder-text;
    out property <bool> has-focus: trigger.has-focus || menu.is-open;
    callback selected(string);
    forward-focus: trigger;
    min-height: 34px;
    max-height: 36px;
    vertical-stretch: 0;
    min-width: 120px;
    background: pointer.has-hover && root.available ? #203b55 : #142b41;
    border-width: 1px;
    border-color: root.has-focus ? #e7c46a : #34475b;
    accessible-role: combobox;
    accessible-enabled: root.available;
    accessible-value: root.value;
    accessible-expandable: true;
    accessible-expanded: menu.is-open;
    accessible-action-default => { root.toggle-menu(); }
    changed available => { if !root.available && menu.is-open { menu.close(); } }
    changed model => { if menu.is-open { menu.close(); } }

    function toggle-menu() {
        if menu.is-open {
            menu.close();
        } else if root.available {
            trigger.focus();
            root.highlight = max(0, root.displayed-index);
            menu.show();
        }
    }
    function choose(index: int) {
        if index >= 0 && index < root.model.length {
            let value = root.model[index];
            menu.close();
            root.current-index = index;
            root.selected(value);
        }
    }
    Text {
        x: 10px; width: parent.width - 40px;
        text: root.value; color: root.available ? #ebe7dc : #9eabb9;
        font-size: 14px; vertical-alignment: center; overflow: elide;
    }
    Text {
        x: parent.width - 26px; width: 18px;
        text: "▾"; color: #b5bcc7; font-size: 12px;
        horizontal-alignment: center; vertical-alignment: center;
    }
    trigger := FocusScope {
        enabled: root.available;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " || event.text == Key.DownArrow || event.text == Key.UpArrow {
                if !event.repeat { root.toggle-menu(); }
                return accept;
            }
            return reject;
        }
    }
    pointer := TouchArea {
        enabled: root.available;
        clicked => { root.toggle-menu(); }
    }

    // Winit hosts this anchored list in the parent surface.
    menu := PopupWindow {
        x: 0; y: root.height + 2px;
        width: root.width;
        height: min(7, root.model.length) * root.row-height + 2px;
        close-policy: close-on-click-outside;
        forward-focus: keys;
        init => { keys.focus(); keys.reveal(root.highlight); }
        keys := FocusScope {
            focus-on-click: false;
            function reveal(index: int) {
                root.highlight = min(root.model.length - 1, max(0, index));
                let start = root.highlight * root.row-height;
                list.content-y = min(-start, max(list.visible-height - start - root.row-height, list.content-y));
            }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    menu.close();
                    return accept;
                }
                if event.text == Key.Return || event.text == " " {
                    if !event.repeat { root.choose(root.highlight); }
                    return accept;
                }
                if event.text == Key.DownArrow || event.text == Key.UpArrow {
                    self.reveal(root.highlight + (event.text == Key.DownArrow ? 1 : -1));
                    return accept;
                }
                if event.text == Key.Home || event.text == Key.End {
                    self.reveal(event.text == Key.Home ? 0 : root.model.length - 1);
                    return accept;
                }
                if event.text == Key.Tab { menu.close(); }
                return reject;
            }
            Rectangle {
                background: #142b41;
                border-width: 1px; border-color: #53697d;
                list := ListView {
                    x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                    content-width: self.visible-width;
                    for entry[index] in root.model: PanelButton {
                        height: root.row-height;
                        text: entry; navigation: true; checked: root.highlight == index;
                        clicked => { root.choose(index); }
                    }
                }
            }
        }
    }
}

export component PanelOverlay inherits Rectangle {
    callback backdrop-clicked;
    in property <bool> embedded;
    in property <string> heading;
    in property <length> panel-width: 900px;
    in property <length> panel-height: 700px;
    in property <length> header-height: 52px;
    in property <image> brand-mark: @image-url("../../../assets/icons/pttstella.png");
    in property <image> heading-icon;
    background: root.embedded ? transparent : #00000088;
    TouchArea {
        enabled: root.visible && !root.embedded;
        width: parent.width; height: parent.height;
        clicked => {
            if self.mouse-x < panel.x || self.mouse-x >= panel.x + panel.width
                || self.mouse-y < panel.y || self.mouse-y >= panel.y + panel.height {
                root.backdrop-clicked();
            }
        }
        scroll-event => { return accept; }
    }
    panel := Rectangle {
        width: root.embedded ? parent.width : min(root.panel-width, parent.width - 32px);
        height: root.embedded ? parent.height : min(root.panel-height, parent.height - 32px);
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        background: root.embedded ? transparent : #0c1c30;
        border-color: #34475b; border-width: root.embedded ? 0px : 1px; border-radius: 3px;
        drop-shadow-color: root.embedded ? transparent : #00000099; drop-shadow-offset-y: 12px; drop-shadow-blur: 40px;
        clip: true;
        VerticalLayout {
            if !root.embedded: Rectangle {
                height: root.header-height;
                HorizontalLayout {
                    padding-left: 22px; padding-right: 22px; spacing: 10px;
                    Rectangle {
                        width: 24px;
                        Image { width: 24px; height: 24px; y: (parent.height - self.height) / 2; source: root.brand-mark; image-fit: contain; }
                    }
                    Text { text: "PTTStella"; color: #ebe7dc; font-size: 16px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    if root.heading-icon.width > 0: Image {
                        source: root.heading-icon; width: 18px; height: 18px;
                        colorize: #e7c46a; y: (parent.height - self.height) / 2;
                    }
                    Text { text: root.heading; color: #b5bcc7; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                }
                Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #34475b; }
            }
            Rectangle { vertical-stretch: 1; clip: true; @children }
        }
    }
}
