import { Button } from "std-widgets.slint";
import { UiLabels } from "labels.slint";

export component ReplyNavigationBar inherits FocusScope {
    min-height:root.visible ? controls.min-height : 0px;
    preferred-height:root.visible ? controls.preferred-height : 0px;
    max-height:root.visible ? controls.max-height : 0px;
    in property <bool> blocked;
    in property <[bool]> groups;
    in property <int> group;
    in property <string> count;
    callback action(int);
    callback focus-navigation;
    function refresh-group() {author.checked=root.group==0;mine.checked=root.group==1;focused-id.checked=root.group==2;}
    changed group=>{root.refresh-group();}
    out property <bool> focused: self.has-focus || author.has-focus || mine.has-focus || focused-id.has-focus || previous.has-focus || next.has-focus || close.has-focus;
    focus-navigation => { if root.groups[0] {author.focus();} else if root.groups[1] {mine.focus();} else {focused-id.focus();} }
    key-pressed(event) => {
        if root.blocked || event.modifiers.control || event.modifiers.meta || event.modifiers.alt {return reject;}
        if event.text==Key.Escape {root.action(1);return accept;}
        if event.text==Key.UpArrow {root.action(2);return accept;}
        if event.text==Key.DownArrow {root.action(3);return accept;}
        return reject;
    }
    controls := HorizontalLayout {
        spacing:6px;
        author := Button { text:UiLabels.reply-author; checkable:true; checked:root.group==0; enabled:!root.blocked && root.groups[0];clicked=>{root.action(4);root.refresh-group();} }
        mine := Button { text:UiLabels.reply-mine;accessible-label:root.groups[3] ? UiLabels.reply-mine : UiLabels.reply-unconfirmed;checkable:true;checked:root.group==1;enabled:!root.blocked && root.groups[1];clicked=>{root.action(5);root.refresh-group();} }
        focused-id := Button { text:UiLabels.reply-focused;checkable:true;checked:root.group==2;enabled:!root.blocked && root.groups[2];clicked=>{root.action(6);root.refresh-group();} }
        Text {text:root.count;horizontal-stretch:1;vertical-alignment:center;}
        previous := Button {text:UiLabels.reply-previous;enabled:!root.blocked && root.groups[root.group];clicked=>{root.action(2);} }
        next := Button {text:UiLabels.reply-next;enabled:!root.blocked && root.groups[root.group];clicked=>{root.action(3);} }
        close := Button {text:UiLabels.editor-close;clicked=>{root.action(1);} }
    }
}
