import { AboutSlint, ScrollView } from "std-widgets.slint";
import { PanelButton, PanelField, PanelCheck, PanelCombo, PanelOverlay } from "panel.slint";
global SettingsInput {
    in-out property <int> focused:-1;
    in-out property <int> active-target:-1;
    in-out property <int> command;
    in-out property <int> command-sequence;
    in-out property <int> focus-field:-1;
    in-out property <int> focus-sequence;
}
component EditField inherits PanelField {
    in property <int> field-id;
    background: #142b41;
    private property <int> command-sequence:SettingsInput.command-sequence;
    private property <int> focus-sequence:SettingsInput.focus-sequence;
    changed has-focus=>{
        if self.has-focus {SettingsInput.focused=self.field-id; SettingsInput.active-target=self.field-id;}
        else {if SettingsInput.focused==self.field-id {SettingsInput.focused=-1;} if SettingsInput.active-target==self.field-id {SettingsInput.active-target=-1;}}
    }
    changed focus-sequence=>{if SettingsInput.focus-field==self.field-id {self.focus();}}
    changed command-sequence=>{
        if self.has-focus {
            if SettingsInput.command==0 {self.select-all();}
            else if SettingsInput.command==1 {self.copy();}
            else if SettingsInput.command==2 {self.cut();}
            else if SettingsInput.command==3 {self.paste();}
            else if SettingsInput.command==4 {self.undo();}
            else if SettingsInput.command==5 {self.redo();}
        }
    }
}
component SettingsAction inherits PanelButton {
    max-width: self.preferred-width;
}
component FocusButton inherits SettingsAction {
    in property <int> field-id;
    private property <int> focus-sequence:SettingsInput.focus-sequence;
    changed focus-sequence=>{if SettingsInput.focus-field==self.field-id {self.focus();}}
    changed has-focus=>{if self.has-focus {SettingsInput.active-target=self.field-id;} else if SettingsInput.active-target==self.field-id {SettingsInput.active-target=-1;}}
}
component FocusCombo inherits PanelCombo {
    in property <int> field-id;
    enabled: SettingsState.active && !SettingsState.composing;
    private property <int> focus-sequence:SettingsInput.focus-sequence;
    changed focus-sequence=>{if SettingsInput.focus-field==self.field-id {self.focus();}}
    changed has-focus=>{if self.has-focus {SettingsInput.active-target=self.field-id;} else if SettingsInput.active-target==self.field-id {SettingsInput.active-target=-1;}}
}
component SettingsRow inherits VerticalLayout {
    in property <string> caption;
    in property <length> caption-width;
    spacing: 0;
    HorizontalLayout {
        spacing: 10px; padding-top: 13px; padding-bottom: 13px;
        Text {
            width: root.caption-width;
            text: root.caption; color: #ebe7dc; font-size: 14px;
            vertical-alignment: center; wrap: word-wrap;
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
    Rectangle { height: 1px; background: #34475b; }
}
component FocusCheck inherits PanelCheck {
    in property <int> field-id;
    flat: true;
    private property <int> focus-sequence:SettingsInput.focus-sequence;
    changed focus-sequence=>{if SettingsInput.focus-field==self.field-id {self.focus();}}
    changed has-focus=>{if self.has-focus {SettingsInput.active-target=self.field-id;} else if SettingsInput.active-target==self.field-id {SettingsInput.active-target=-1;}}
}
export struct FontSource { id:string,title:string }
export struct SettingsMatch { title:string, page:int, field:int }

export global SettingsState {
    in-out property <bool> active;
    in-out property <[string]> labels;
    in-out property <[string]> runtime-labels;
    in-out property <[bool]> runtime-states;
    in-out property <[bool]> runtime-available;
    in-out property <string> profile-name;
    out property <int> focused-target:SettingsInput.active-target;
    changed focused-target=>{if root.focused-target==0 {root.cancel-result-focus();}}
    callback runtime-action(int);
    in-out property <[string]> categories;
    in-out property <[string]> presets;
    in-out property <[string]> languages;
    in-out property <[string]> modes;
    in-out property <[string]> positions;
    in-out property <[SettingsMatch]> matches;
    in-out property <int> page;
    in-out property <string> query;
    in-out property <int> preset;
    in-out property <string> ascii;
    in-out property <string> cjk;
    in-out property <string> font-size;
    in-out property <string> baseline;
    in-out property <string> font-width;
    in-out property <int> language;
    in-out property <int> article-mode;
    in-out property <bool> boundary;
    in-out property <bool> automatic;
    in-out property <int> hover;
    in-out property <string> tool-opacity;
    in-out property <bool> right-click;
    in-out property <bool> show-ball;
    in-out property <image> preview;
    out property <bool> preview-visible: root.query == "" && root.page == 1;
    callback refresh-preview;
    in-out property <string> font-status;
    in-out property <string> notice;
    in-out property <bool> failed;
    in-out property <bool> release-enabled;
    in-out property <bool> release-checking;
    in-out property <bool> release-available;
    in-out property <string> release-status;
    in-out property <[string]> release-labels;
    callback release-check;
    callback release-open;
    callback repository-open;
    callback edit;
    callback search(string);
    callback reset;
    callback retry;
    callback close-settings;
    callback manage-account;
    callback manage-sites;
    callback manage-filters;
    in-out property <string> filters-label;
    in-out property <bool> filters-available;
    in-out property <string> sites-label;
    in-out property <bool> sites-available;
    callback font-preset;
    callback custom-font;
    callback profile(bool);
    callback catalog;
    in-out property <[string]> families;
    in-out property <string> catalog-status;
    pure callback installed-family-index([string], string) -> int;
    callback family(bool,string);
    in-out property <[FontSource]> font-sources;
    callback font-source(string);
    callback edit-key(int)->bool;
    edit-key(code)=>{
        if SettingsInput.focused<0 {return false;}
        SettingsInput.command=code;SettingsInput.command-sequence=1-SettingsInput.command-sequence;return true;
    }
    callback show-page(int);
    show-page(index) => {
        root.cancel-result-focus();
        root.query = "";
        root.page = index;
        root.refresh-preview();
    }
    callback choose-result(int);
    choose-result(index)=>{
        if index>=0 && index<root.matches.length {
            let item=root.matches[index];
            root.show-page(item.page);root.focus-result(item.field);
        }
    }
    callback cancel-result-focus;
    callback focus-result(int);
    callback focus-field(int);
    focus-field(field)=>{SettingsInput.focus-field=field;SettingsInput.focus-sequence+=1;}
    callback focus-search;
    focus-search => { root.cancel-result-focus(); root.focus-field(0); }
    in-out property <bool> composing;
}

export component SettingsPanel inherits PanelOverlay {
    in property <float> zoom: 1;
    private property <length> form-width: min(root.width - 32px, root.panel-width);
    private property <length> sidebar-width: root.form-width < 680px ? 155px : 195px;
    private property <length> label-width: max(92px, (root.form-width - root.sidebar-width - 45px) * 0.30);
    heading: SettingsState.labels[0];
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape && !SettingsState.composing && !event.repeat {
                SettingsState.close-settings();
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            spacing: 0;
            HorizontalLayout {
                spacing: 0;
                ScrollView {
                    width: root.sidebar-width;
                    content-width: self.visible-width;
                    VerticalLayout {
                        alignment: start; padding-top: 16px; spacing: 8px;
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px;
                            EditField { field-id: 0; placeholder-text:SettingsState.labels[1]; text<=>SettingsState.query; edited=>{SettingsState.search(self.text);SettingsState.refresh-preview();} }
                        }
                        for item[index] in SettingsState.categories: PanelButton {
                            text: item; navigation: true; checked: SettingsState.page == index && SettingsState.query == "";
                            clicked => { SettingsState.show-page(index); }
                        }
                    }
                }
                Rectangle { width: 1px; background: #34475b; }
                ScrollView { content-width:self.visible-width;
                    VerticalLayout {
                        alignment: start; padding: 22px; spacing: 12px;
                        Rectangle { width: 28px; height: 2px; background: #e7c46a; }
                        Text { text: SettingsState.query == "" ? SettingsState.categories[SettingsState.page] : SettingsState.labels[1]; color: #ebe7dc; font-size: 20px; }
                        if SettingsState.query!="": VerticalLayout {
                            alignment: start; spacing: 10px;
                            for item[index] in SettingsState.matches: PanelButton { text:item.title + " · " + SettingsState.categories[item.page];clicked=>{SettingsState.choose-result(index);} }
                            if SettingsState.matches.length==0: Text { text:SettingsState.labels[2];color:#d7dce5;wrap:word-wrap; }
                        }
                        if SettingsState.query=="" && SettingsState.page==0: VerticalLayout {
                            alignment: start; spacing: 10px;
                            FocusButton {field-id:23;text:SettingsState.runtime-labels[3];enabled:SettingsState.runtime-available[3];checked:SettingsState.runtime-states[3];clicked=>{SettingsState.runtime-action(3);}}
                            SettingsRow {
                                caption-width: root.label-width;
                                caption: SettingsState.labels[3];
                                FocusCombo {field-id:10;accessible-label:SettingsState.labels[3];model:SettingsState.languages;current-index<=>SettingsState.language;selected=>{SettingsState.edit();}}
                            }
                            Text {text:SettingsState.labels[4];color:#d7dce5;wrap:word-wrap;}
                            SettingsRow {
                                caption-width: root.label-width;
                                caption: SettingsState.labels[5];
                                FocusCombo {field-id:14;accessible-label:SettingsState.labels[5];model:SettingsState.modes;current-index<=>SettingsState.article-mode;selected=>{SettingsState.edit();}}
                            }
                            Text {text:SettingsState.labels[6];color:#d7dce5;wrap:word-wrap;}
                            FocusCheck {field-id:16;caption:SettingsState.labels[7];checked<=>SettingsState.boundary;toggled=>{SettingsState.edit();}}
                        }
                        if SettingsState.preview-visible: VerticalLayout {
                            alignment: start; spacing: 0;
                            HorizontalLayout {
                                alignment: start; spacing: 8px; padding-bottom: 14px;
                                SettingsAction {text:"−";accessible-label:SettingsState.labels[37];clicked=>{SettingsState.runtime-action(6);}}
                                Text {text:round(root.zoom * 100) + "%";color:#ebe7dc;font-size:16px;vertical-alignment:center;}
                                SettingsAction {text:"+";accessible-label:SettingsState.labels[38];clicked=>{SettingsState.runtime-action(7);}}
                                FocusButton {field-id:20;text:SettingsState.runtime-labels[0];clicked=>{SettingsState.runtime-action(0);}}
                            }
                            SettingsRow {
                                caption-width: root.label-width;
                                caption: SettingsState.labels[8];
                                FocusCombo {field-id:11;accessible-label:SettingsState.labels[8];model:SettingsState.presets;current-index<=>SettingsState.preset;selected=>{SettingsState.font-preset();}}
                            }
                            SettingsRow {
                                caption-width: root.label-width;
                                caption: SettingsState.labels[9];
                                EditField {field-id:1;accessible-label:SettingsState.labels[9];text<=>SettingsState.ascii;edited=>{SettingsState.custom-font();}}
                            }
                            SettingsRow {
                                caption-width: root.label-width;
                                caption: SettingsState.labels[34];
                                PanelCombo {
                                    accessible-label: SettingsState.labels[34];
                                    enabled: SettingsState.active && !SettingsState.composing;
                                    model: SettingsState.families;
                                    displayed-index: SettingsState.installed-family-index(SettingsState.families, SettingsState.ascii);
                                    placeholder-text: SettingsState.labels[36];
                                    selected(value) => { SettingsState.family(false,value); }
                                }
                            }
                            SettingsRow {
                                caption-width: root.label-width;
                                caption: SettingsState.labels[10];
                                EditField {field-id:2;accessible-label:SettingsState.labels[10];text<=>SettingsState.cjk;edited=>{SettingsState.custom-font();}}
                            }
                            SettingsRow {
                                caption-width: root.label-width;
                                caption: SettingsState.labels[35];
                                PanelCombo {
                                    accessible-label: SettingsState.labels[35];
                                    enabled: SettingsState.active && !SettingsState.composing;
                                    model: SettingsState.families;
                                    displayed-index: SettingsState.installed-family-index(SettingsState.families, SettingsState.cjk);
                                    placeholder-text: SettingsState.labels[36];
                                    selected(value) => { SettingsState.family(true,value); }
                                }
                            }
                            HorizontalLayout {
                                alignment: end;
                                SettingsAction {text:SettingsState.labels[11];clicked=>{SettingsState.catalog();}}
                            }
                            if SettingsState.catalog-status != "": Text {
                                text: SettingsState.catalog-status; color: #b5bcc7;
                                wrap: word-wrap;
                            }
                            SettingsRow {
                                caption-width: root.label-width;
                                caption: SettingsState.labels[12];
                                EditField {field-id:3;accessible-label:SettingsState.labels[12];text<=>SettingsState.font-size;edited=>{SettingsState.edit();}}
                            }
                            SettingsRow {
                                caption-width: root.label-width;
                                caption: SettingsState.labels[14];
                                EditField {field-id:5;accessible-label:SettingsState.labels[14];text<=>SettingsState.font-width;edited=>{SettingsState.edit();}}
                            }
                            SettingsRow {
                                caption-width: root.label-width;
                                caption: SettingsState.labels[13];
                                EditField {field-id:4;accessible-label:SettingsState.labels[13];text<=>SettingsState.baseline;edited=>{SettingsState.edit();}}
                            }
                            Text {text:SettingsState.labels[15];color:#b5bcc7;wrap:word-wrap;}
                            Image {source:SettingsState.preview;image-fit:contain;height:144px;}
                            Text {text:SettingsState.font-status;color:#e4c76e;wrap:word-wrap;}
                            SettingsRow {
                                caption-width: root.label-width;
                                caption: SettingsState.labels[33];
                                EditField {field-id:7;accessible-label:SettingsState.labels[33];text<=>SettingsState.profile-name;}
                            }
                            HorizontalLayout {
                                alignment: start; spacing: 8px;
                                SettingsAction {text:SettingsState.labels[16];clicked=>{SettingsState.profile(false);}}
                                SettingsAction {text:SettingsState.labels[17];clicked=>{SettingsState.profile(true);}}
                            }
                            Text {text:SettingsState.labels[18];color:#d7dce5;wrap:word-wrap;}
                            for source in SettingsState.font-sources:
                                SettingsAction {text:source.title;clicked=>{SettingsState.font-source(source.id);}}
                        }
                        if SettingsState.query=="" && SettingsState.page==2: VerticalLayout {
                            alignment: start; spacing: 10px;
                            Rectangle {
                                private property <length> gap: 10px;
                                private property <bool> stack: vim.preferred-width + gap + mouse.preferred-width > self.width;
                                height: mouse.y + mouse.height;
                                vim := FocusButton {
                                    x: 0; y: 0; width: min(parent.width, self.preferred-width); height: self.preferred-height;
                                    field-id:21;text:SettingsState.runtime-labels[1];enabled:SettingsState.runtime-available[1];checked:SettingsState.runtime-states[1];clicked=>{SettingsState.runtime-action(1);}
                                }
                                mouse := FocusButton {
                                    x: parent.stack ? 0px : vim.width + parent.gap;
                                    y: parent.stack ? vim.height + parent.gap : 0px;
                                    width: min(parent.width, self.preferred-width); height: self.preferred-height;
                                    field-id:22;text:SettingsState.runtime-labels[2];enabled:SettingsState.runtime-available[2];checked:SettingsState.runtime-states[2];clicked=>{SettingsState.runtime-action(2);}
                                }
                            }
                            HorizontalLayout {
                                alignment: start; spacing: 8px;
                                if SettingsState.runtime-available[5]: SettingsAction {text:SettingsState.runtime-labels[5];clicked=>{SettingsState.runtime-action(5);}}
                                SettingsAction {text:SettingsState.runtime-labels[4];enabled:SettingsState.runtime-available[4];clicked=>{SettingsState.runtime-action(4);}}
                            }
                            HorizontalLayout {
                                alignment: start; spacing: 10px;
                                Text {text:SettingsState.labels[19];color:#d7dce5;vertical-alignment:center;}
                                opacity-field:=EditField {
                                    field-id:6; min-width: 64px; max-width: 64px;
                                    accessible-label: SettingsState.labels[19];
                                    text<=>SettingsState.tool-opacity;edited=>{SettingsState.edit();}
                                }
                                Text {text:"%";color:#d7dce5;vertical-alignment:center;}
                            }
                            Rectangle { height: 1px; background: #34475b; }
                            FocusCheck {field-id:12;caption:SettingsState.labels[20];checked<=>SettingsState.right-click;toggled=>{SettingsState.edit();}}
                            Rectangle { height: 1px; background: #34475b; }
                            FocusCheck {field-id:13;caption:SettingsState.labels[21];checked<=>SettingsState.show-ball;toggled=>{SettingsState.edit();}}
                            Rectangle { height: 1px; background: #34475b; }
                            Text {text:SettingsState.labels[22];color:#d7dce5;wrap:word-wrap;}
                        }
                        if SettingsState.query=="" && SettingsState.page==3: VerticalLayout {
                            alignment: start; spacing: 10px;
                            SettingsRow {
                                caption-width: root.label-width;
                                caption: SettingsState.labels[23];
                                FocusCombo {field-id:17;accessible-label:SettingsState.labels[23];model:SettingsState.positions;current-index<=>SettingsState.hover;selected=>{SettingsState.edit();}}
                            }
                            FocusCheck {field-id:15;caption:SettingsState.labels[24];checked<=>SettingsState.automatic;toggled=>{SettingsState.edit();}}
                            Text {text:SettingsState.labels[25];color:#d7dce5;wrap:word-wrap;}
                        }
                        if SettingsState.query=="" && SettingsState.page==4: VerticalLayout {
                            alignment: start; spacing: 10px;
                            if SettingsState.sites-available: FocusButton {field-id:18;text:SettingsState.sites-label;clicked=>{SettingsState.manage-sites();}}
                        }
                        if SettingsState.query=="" && SettingsState.page==5: VerticalLayout {
                            alignment: start; spacing: 10px;
                            if SettingsState.filters-available: FocusButton {field-id:26;text:SettingsState.filters-label;clicked=>{SettingsState.manage-filters();}}
                        }
                        if SettingsState.query=="" && SettingsState.page==6: VerticalLayout {
                            alignment: start; spacing: 10px;
                            Text {text:SettingsState.labels[26];color:#d7dce5;wrap:word-wrap;}
                            FocusButton {field-id:19;text:SettingsState.labels[27];clicked=>{SettingsState.manage-account();}}
                        }
                        if SettingsState.query=="" && SettingsState.page==7: VerticalLayout {
                            alignment: start; spacing: 10px;
                            FocusScope {
                                height:40px;
                                private property <int> focus-sequence:SettingsInput.focus-sequence;
                                changed focus-sequence=>{if SettingsInput.focus-field==25 {self.focus();}}
                                changed has-focus=>{if self.has-focus {SettingsInput.active-target=25;} else if SettingsInput.active-target==25 {SettingsInput.active-target=-1;}}
                                Text {text:"PTTStella Slint · " + SettingsState.labels[28];color:#e4c76e;wrap:word-wrap;}
                            }
                            FocusButton {field-id:27;text:SettingsState.release-labels[0];enabled:SettingsState.release-enabled && !SettingsState.release-checking;clicked=>{SettingsState.release-check();}}
                            if SettingsState.release-available: FocusButton {field-id:28;text:SettingsState.release-labels[1];enabled:SettingsState.release-enabled;clicked=>{SettingsState.release-open();}}
                            Text {text:SettingsState.release-status;color:#e4c76e;wrap:word-wrap;}
                            Text {text:SettingsState.release-labels[2];color:#d7dce5;wrap:word-wrap;}
                            FocusButton {field-id:29;text:SettingsState.release-labels[3];clicked=>{SettingsState.repository-open();}}
                            AboutSlint {}
                            Text {text:SettingsState.labels[29];color:#d7dce5;wrap:word-wrap;}
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: #34475b; }
            HorizontalLayout {
                padding: 14px; spacing: 8px;
                Text {text:SettingsState.notice;color:SettingsState.failed ? #ffb5ac : #b5bcc7;wrap:word-wrap;horizontal-stretch:1;vertical-alignment:center;}
                FocusButton {field-id:24;text:SettingsState.labels[30];enabled:SettingsState.page<4;clicked=>{SettingsState.reset();}}
                if SettingsState.failed: SettingsAction {text:SettingsState.labels[31];clicked=>{SettingsState.retry();}}
                SettingsAction {text:SettingsState.labels[32];primary:true;clicked=>{SettingsState.close-settings();}}
            }
        }
    }
}
