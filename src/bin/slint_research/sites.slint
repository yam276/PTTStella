import { Button, ComboBox, LineEdit } from "std-widgets.slint";
component Field inherits LineEdit {
    public function edit-key(code:int) {
        if code==0 {self.select-all();} else if code==1 {self.copy();} else if code==2 {self.cut();}
        else if code==3 {self.paste();} else if code==4 {self.undo();} else if code==5 {self.redo();}
    }
}
export component SitesWindow inherits Window {
    title:root.labels[0]; preferred-width:800px;preferred-height:650px;min-width:640px;min-height:520px;background:#171b23;
    in property <[string]> labels;
    in property <[string]> favourites;
    in property <string> default-note;
    in property <string> current-note;
    in property <string> message;
    in property <string> security;
    in property <bool> writable;
    in property <bool> busy;
    in property <bool> composing;
    in-out property <int> choice;
    in-out property <string> name;
    in-out property <string> address;
    in-out property <int> encoding;
    callback choose(int);
    callback preset(bool);
    callback action(int);
    callback close-sites;
    callback field-edit(int,string)->string;
    public function edit-key(code:int)->bool {
        if name-field.has-focus {name-field.edit-key(code);return true;}
        if address-field.has-focus {address-field.edit-key(code);return true;}
        return false;
    }
    public function focus-address() {address-field.focus();}
    keys:=FocusScope {
      width:parent.width;height:parent.height;
      key-pressed(event)=>{if event.text==Key.Escape && !root.composing {root.close-sites();return accept;}return reject;}
      VerticalLayout {padding:16px;spacing:10px;
        Text {text:root.labels[14];color:#c7d4e7;wrap:word-wrap;}
        Text {text:root.current-note;color:#c7d4e7;wrap:word-wrap;}
        Text {text:root.default-note;color:#f2cd7d;wrap:word-wrap;}
        Text {text:root.labels[1];color:#c7d4e7;}
        ComboBox {model:root.favourites;current-index<=>root.choice;enabled:!root.busy && !root.composing;selected=>{root.choose(self.current-index);} }
        HorizontalLayout {
            Button {text:root.labels[10];enabled:!root.busy && !root.composing;clicked=>{root.preset(false);} }
            Button {text:root.labels[11];enabled:!root.busy && !root.composing;clicked=>{root.preset(true);} }
        }
        Text {text:root.labels[3];color:#c7d4e7;}
        name-field:=Field {text<=>root.name;accessible-label:root.labels[3];enabled:!root.busy;edited=>{self.text=root.field-edit(0,self.text);} }
        Text {text:root.labels[4];color:#c7d4e7;}
        address-field:=Field {text<=>root.address;accessible-label:root.labels[4];enabled:!root.busy;edited=>{self.text=root.field-edit(1,self.text);} }
        Text {text:root.labels[5];color:#c7d4e7;}
        ComboBox {model:["Big5-UAO","Big5","GBK"];current-index<=>root.encoding;enabled:!root.busy && !root.composing;}
        Text {text:root.security;color:#9ab5ce;wrap:word-wrap;}
        HorizontalLayout {
            Button {text:root.labels[6];enabled:root.writable && !root.busy && !root.composing;clicked=>{root.action(0);} }
            Button {text:root.labels[7];enabled:root.writable && root.choice>0 && !root.busy && !root.composing;clicked=>{root.action(1);} }
            Button {text:root.labels[8];enabled:root.writable && !root.busy && !root.composing;clicked=>{root.action(2);} }
        }
        Text {text:root.message;color:#f2cd7d;wrap:word-wrap;vertical-stretch:1;}
        HorizontalLayout {
            Button {text:root.labels[13];enabled:!root.busy && !root.composing;clicked=>{root.action(4);} }
            Button {text:root.labels[9];enabled:!root.busy && !root.composing && root.address!="";clicked=>{root.action(3);} }
            Button {text:root.labels[12];enabled:!root.composing;clicked=>{root.close-sites();} }
        }
      }
    }
}
