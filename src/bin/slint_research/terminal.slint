export { SitesWindow } from "sites.slint";
export { UiLabels } from "labels.slint";
import { UiLabels } from "labels.slint";
export { SettingsWindow, SettingsMatch, FontSource } from "settings.slint";
import { AboutSlint, Button, CheckBox, ComboBox, LineEdit, TextEdit } from "std-widgets.slint";
import { LoginPopup } from "login.slint";
import { ContextMenuOverlay, MenuEntry } from "context-menu.slint";
import { FloatingTools, ToolItem } from "tools.slint";
import { ArticleViewport, ArticleTile, InlineArrow, InlinePicture } from "article.slint";
import { SelectionRect } from "selection.slint";
import { MediaPreview } from "media.slint";
import { MediaHover } from "media-hover.slint";

export { EditorState, DraftItem } from "editor.slint";
import { NativeEditor, EditorState } from "editor.slint";

export { StationColorState } from "station-color.slint";
import { StationColor, StationColorState } from "station-color.slint";

export component TerminalWindow inherits Window {
    callback app-quit;
    in property <bool> app-closing;
    changed app-closing => {root.keyboard-updated();root.keep-alive-changed();root.media-updated();root.tools-updated();root.context-updated();root.station-mouse-cancel();root.find-state-changed();}
    callback native-menu-refresh;
    in property <bool> settings-available;
    in property <bool> settings-open;
    callback settings-show;
    callback settings-runtime-updated;
    changed station-mouse-enabled=>{root.settings-runtime-updated();}
    changed keep-alive-enabled=>{root.settings-runtime-updated();}
    changed keep-alive-available=>{root.settings-runtime-updated();}
    changed vim-label=>{root.settings-runtime-updated();}
    changed station-mouse-label=>{root.settings-runtime-updated();}
    changed keep-alive-label=>{root.settings-runtime-updated();}
    in property <bool> sites-available;
    in property <bool> sites-open;
    in property <string> sites-label;
    in-out property <int> station-choice;
    callback sites-show;
    callback sites-updated;
    callback sites-connect(string,int)->bool;
    changed sites-open=>{root.keyboard-updated();root.keep-alive-changed();root.media-updated();root.tools-updated();root.context-updated();root.station-mouse-cancel();root.find-state-changed();}

    in-out property <int> output-choice;
    changed settings-open => {root.keyboard-updated();root.keep-alive-changed();root.media-updated();root.tools-updated();root.context-updated();root.station-mouse-cancel();root.find-state-changed();}

    out property <bool> station-color-open:StationColorState.open;
    callback station-color-updated;
    callback focus-station-color;
    focus-station-color=>{station-color-view.focus-picker();}
    callback focus-station-color-actions;
    focus-station-color-actions=>{station-color-view.focus-actions();}
    changed station-color-open=>{root.keyboard-updated();root.keep-alive-changed();root.media-updated();root.tools-updated();root.context-updated();root.station-color-updated();root.station-mouse-cancel();}
    out property <bool> editor-open: EditorState.open;
    out property <bool> editor-focused: EditorState.body-focused || EditorState.title-focused;
    out property <bool> editor-body-focused: EditorState.body-focused;
    out property <bool> editor-composing: EditorState.composing;
    out property <SelectionRect> editor-grid-bounds:{x:editor-view.grid-left,y:editor-view.grid-top,width:editor-view.grid-width,height:editor-view.grid-height};
    callback focus-editor-dialog;
    focus-editor-dialog=>{editor-view.focus-dialog();}
    callback focus-editor-palette;
    focus-editor-palette=>{editor-view.focus-palette();}
    callback focus-editor;
    callback clear-editor-input;
    focus-editor => { if EditorState.selected {editor-view.focus-body();} }
    clear-editor-input => { editor-view.clear-input(); }
    callback editor-key(int,bool);
    callback editor-edit-key(int);
    callback editor-title-edit-key(int);
    editor-title-edit-key(code) => {editor-view.title-edit-key(code);}
    callback editor-composition(bool);
    changed editor-open => { root.keyboard-updated();root.keep-alive-changed();root.media-updated();root.tools-updated();root.context-updated();root.station-color-updated();root.find-state-changed();root.station-mouse-cancel(); }
    in property <bool> media-available;
    in property <string> media-auto-label;
    in property <string> media-auto-help;
    in property <bool> media-auto-enabled;
    in-out property <bool> media-auto-choice;
    callback media-auto-preference(bool);
    in property <bool> media-hover-open;
    in property <length> media-hover-x;
    in property <length> media-hover-y;
    in property <int> media-hover-position;
    in-out property <int> media-hover-choice;
    in property <[string]> media-hover-choices;
    in property <string> media-hover-label;
    in property <string> media-hover-help;
    out property <SelectionRect> media-hover-bounds: {x:hover-card.card-left,y:hover-card.card-top,width:hover-card.card-width,height:hover-card.card-height};
    out property <bool> media-hover-blocked: !root.media-available || root.terminal-pointer-blocked || root.selection-active
        || root.keyboard-pending || root.station-mouse-held || (root.pan-mode && !root.article-active)
        || (root.native-pointer-down && !root.media-hover-open);
    changed media-hover-blocked => {root.media-updated();}
    callback media-hover-changed;
    callback media-hover-preference(int);
    in property <bool> media-open;
    in property <bool> media-video;
    out property <bool> media-video-visible: !root.sites-open && !root.settings-open && !root.editor-open && !root.station-color-open && root.media-open && root.media-video && !root.show-about && !root.login-open && !root.paste-open && !root.context-open;
    in property <float> media-position;
    in property <float> media-duration;
    out property <SelectionRect> media-video-bounds: {x:media-preview.video-left,y:media-preview.video-top,width:media-preview.video-width,height:media-preview.video-height};
    callback media-seek(float);
    in property <image> media-image;
    in property <bool> media-ready;
    in property <bool> media-animated;
    in property <bool> media-playing;
    in property <string> media-key;
    in property <string> media-url;
    in property <string> media-status;
    in property <string> media-copy-label;
    in property <string> media-save-label;
    in property <string> media-copy-url-label;
    in property <string> media-close-label;
    in property <string> media-retry-label;
    in property <string> media-motion-label;
    in property <string> media-external-label;
    in property <string> media-fit-label;
    in property <string> media-original-label;
    out property <bool> media-play-allowed: !root.app-closing && !root.sites-open && !root.settings-open && !root.editor-open && !root.station-color-open && root.media-open && root.native-foreground && !root.output-busy && !root.show-about && !root.login-open && !root.paste-open;
    changed media-play-allowed => {root.media-updated();}
    callback media-request(int);
    callback media-action(int);
    callback media-updated;
    callback focus-media;
    title: root.live-session ? "PTTStella Slint" : (root.session-active ? "PTTStella Slint · 本機連線探針" : "PTTStella Slint · 離線原型");
    background: #101318;
    preferred-width: 1000px;
    preferred-height: 690px;
    min-width: 580px;
    min-height: 360px;

    in property <bool> find-available;
    in property <bool> find-open;
    in property <bool> find-composing;
    in property <string> find-title;
    in property <string> find-placeholder;
    in property <string> find-hint;
    in property <string> find-previous-label;
    in property <string> find-next-label;
    in property <string> find-close-label;
    in property <string> find-status;
    in property <bool> find-has-matches;
    in-out property <string> find-query;
    out property <bool> find-focused: root.find-open && find-input.has-focus;
    out property <bool> find-blocked: root.app-closing || root.sites-open || root.settings-open || root.editor-open || root.station-color-open || root.media-open || !root.native-foreground || root.native-composing || root.show-about
        || root.switching-station || root.login-open || root.login-busy || root.paste-open || root.output-busy;
    callback find-action(int);
    callback find-edit(string);
    callback find-edit-key(int);
    callback find-redraw;
    callback find-composition-changed;
    callback find-state-changed;
    callback focus-find(bool);
    callback find-terminal-reveal(int,int);
    changed find-focused => { root.terminal-focus-changed(); }
    changed find-composing => { root.find-composition-changed(); }
    changed find-blocked => { root.find-state-changed(); }
    focus-find(select) => { find-input.focus(); if select { find-input.select-all(); } }
    find-edit-key(code) => {
        if code == 0 { find-input.select-all(); }
        else if code == 1 { find-input.copy(); }
        else if code == 2 { find-input.cut(); }
        else if code == 3 { find-input.paste(); }
        else if code == 4 { find-input.undo(); }
        else if code == 5 { find-input.redo(); }
    }
    find-terminal-reveal(row,col) => {
        viewport.content-y = clamp(viewport.height / 2 - root.raster-height * (row + 0.5) / 24, min(0px, viewport.height - viewport.content-height), 0px);
        viewport.content-x = clamp(viewport.width / 2 - raster.x - root.raster-width * col / 80, min(0px, viewport.width - viewport.content-width), 0px);
    }

    in property <bool> article-active;
    in property <bool> article-station;
    callback article-resume-reading;
    callback article-keyboard-mode(bool);
    in property <[ArticleTile]> article-tiles;
    in property <[InlineArrow]> inline-arrows;
    in property <[InlinePicture]> inline-pictures;
    in property <bool> inline-enabled;
    out property <bool> inline-blocked: root.article-blocked || root.terminal-pointer-blocked || root.selection-active || root.selection-dragging || root.keyboard-pending || root.station-mouse-held;
    changed inline-blocked=>{root.inline-updated();}
    changed article-active=>{root.inline-updated();}
    callback inline-updated;
    callback inline-pointer(int,int,string);
    callback inline-context(int,int,string,length,length);
    callback inline-enter(bool,bool,bool) -> bool;
    changed keyboard-read-only => {root.inline-updated();}
    changed keyboard-pending => {root.inline-updated();}
    changed vim-enabled => {root.inline-updated();root.settings-runtime-updated();}
    changed native-composing => {root.inline-updated();root.station-color-updated();}
    in property <image> article-footer;
    in property <length> article-line-height;
    in property <length> article-line-width;
    in property <length> article-body-height;
    in property <length> article-document-height;
    in property <length> article-offset-y;
    in property <length> article-offset-x;
    out property <bool> article-focused: article-view.focused;
    changed article-focused => { root.terminal-focus-changed(); root.inline-updated(); }
    out property <bool> article-reading-ready: root.native-foreground && root.article-focused && !root.article-blocked && !root.switching-station && !root.native-pointer-down && !root.login-busy && !root.paste-reading && !root.output-busy && !root.selection-active && !root.selection-dragging && !root.keyboard-pending && !root.navigation-busy && !root.station-mouse-held && !root.context-pending;
    changed article-reading-ready => { root.article-session-updated(); }
    out property <bool> article-blocked: root.app-closing || root.sites-open || root.settings-open || root.editor-open || root.station-color-open || root.media-open || root.find-open || root.show-about || root.login-open || root.paste-open || root.tools-busy || root.context-open || root.native-composing;
    callback article-layout-changed;
    callback article-rendered;
    callback article-session-updated;
    callback article-load-action(bool);
    in property <bool> article-load-available;
    in property <bool> article-load-active;
    in property <bool> article-load-can-resume;
    in property <bool> article-load-next-segment;
    in property <string> article-load-status;
    callback article-scroll(float,bool);
    callback article-navigate(int);
    callback article-scroll-to(bool,float);
    callback article-zoom-request(float);
    callback focus-article;
    focus-article => { article-view.focus-article(); }

    in property <bool> tools-available;
    in property <bool> tools-open;
    in property <bool> tools-busy;
    in property <bool> tools-dragging;
    in property <bool> tools-visible: true;
    in property <bool> tools-right-click: true;
    in property <bool> tools-reduced-motion: true;
    in property <float> tools-opacity: 1;
    in property <float> tools-scale: 1;
    in property <length> tools-x;
    in property <length> tools-y;
    in property <bool> tools-compact;
    in property <SelectionRect> tools-panel;
    in property <length> tools-grid-height;
    in property <int> tools-category: -1;
    in property <int> tools-selected;
    in property <[ToolItem]> tools-categories;
    in property <[ToolItem]> tools-actions;
    in property <string> tools-title;
    in property <string> tools-ball-label;
    out property <bool> tools-source-blocked: root.app-closing || root.sites-open || root.settings-open || root.editor-open || root.station-color-open || root.media-open || root.find-open || !root.native-foreground || root.native-composing || root.show-about || root.login-open || root.login-busy || root.paste-open || root.paste-reading || root.output-busy;
    out property <bool> pointer-shift-held: root.pointer-shift;
    callback native-shift-held() -> bool;
    callback tools-pointer(int,length,length);
    callback tools-toggle;
    callback tools-dismiss(bool);
    callback tools-category-choose(int);
    callback tools-action-choose(int);
    callback tools-action-pointer(int,int);
    callback tools-key(int,bool);
    callback tools-updated;
    callback tools-resized;
    callback tools-cancel-gesture;
    callback tools-show-at(length,length) -> bool;
    callback focus-tools;
    changed width => { root.tools-resized(); }
    changed height => { root.tools-resized(); }
    changed tools-source-blocked => { root.tools-updated(); }
    in property <image> terminal-image;
    in property <string> result: "輸入探針只在本機驗證編碼";
    out property <length> view-width: viewport.width;
    out property <length> view-height: viewport.height;
    out property <length> raster-left: viewport.content-x + raster.x;
    out property <length> raster-top: viewport.content-y + raster.y;
    in-out property <float> zoom: 1;
    in property <length> raster-width;
    in property <length> raster-height;
    in property <bool> terminal-input;
    in property <bool> keyboard-read-only;
    in property <bool> keyboard-pending;
    in property <bool> vim-available;
    in property <bool> vim-enabled;
    in property <bool> vim-once-available;
    in property <string> vim-label;
    in property <string> vim-once-label;
    in property <string> keyboard-label;
    callback toggle-vim;
    callback vim-once;
    callback keyboard-updated;
    callback reset-keyboard;
    in property <length> caret-left;
    in property <length> caret-top;
    in property <length> caret-height;
    out property <bool> terminal-input-focused: grid-input.has-focus;
    callback terminal-focus-changed;
    callback focus-terminal;
    callback session-updated;
    callback geometry-changed;
    callback submit(string);
    in property <bool> session-active;
    in property <bool> live-session;
    in property <bool> show-reconnect;
    in property <bool> switching-station;
    in property <string> session-warning;
    in property <[string]> stations;
    callback switch-station(int);
    in property <bool> can-reconnect;
    callback reconnect;
    callback toggle-fullscreen;
    callback leave-fullscreen() -> bool;
    in property <string> input-notice;
    in property <bool> paste-open;
    in property <string> paste-title;
    in property <string> paste-preview;
    in property <string> paste-cancel-label;
    in property <string> paste-send-label;
    callback paste-cancel;
    callback paste-request;
    callback paste-confirm;
    callback show-paste-preview;
    callback hide-paste-preview(bool);
    in property <bool> paste-reading;
    in property <bool> native-foreground;
    in property <bool> native-composing;
    in property <bool> native-pointer-down;
    in property <int> native-pointer-buttons;
    in property <bool> frame-paint-pending;
    in property <bool> keep-alive-available;
    in property <bool> keep-alive-enabled;
    in property <string> keep-alive-label;
    out property <bool> keep-alive-surface-ready: !root.app-closing && !root.sites-open && !root.settings-open && !root.editor-open && !root.station-color-open && !root.media-open && !root.find-open && root.native-foreground
        && (root.article-active ? root.article-focused : root.terminal-input-focused) && !root.native-composing && !root.native-pointer-down
        && !root.show-about && !root.switching-station && !root.paste-open && !root.paste-reading
        && !root.frame-paint-pending && !root.login-open && !root.login-busy
        && !root.selection-active && !root.selection-dragging && !root.output-busy
        && !root.keyboard-pending && !root.navigation-busy && !root.station-mouse-held && !root.context-open && !root.context-pending && !root.tools-busy;
    callback keep-alive-changed;
    callback toggle-keep-alive;
    in property <bool> login-open;
    in property <bool> login-busy;
    in property <bool> login-saved;
    in property <bool> login-available;
    in property <bool> login-pending;
    in property <string> login-label;
    in property <string> login-title;
    in property <string> login-account-label;
    in property <string> login-password-label;
    in property <string> login-remember-label;
    in property <string> login-forget-label;
    in property <string> login-cancel-label;
    in property <string> login-cancel-attempt-label;
    in property <string> login-message;
    in-out property <string> login-account;
    callback login-show;
    callback login-submit(string, string, bool);
    callback login-cancel;
    callback login-forget;
    callback login-updated;
    callback show-login-popup;
    callback hide-login-popup(bool);
    callback clear-login-password;
    callback login-limit-text(string, int) -> string;
    in property <[SelectionRect]> selection-rects;
    in property <bool> selection-active;
    in property <bool> selection-rows-ready;
    in property <bool> selection-dragging;
    in property <bool> output-available;
    in property <bool> output-busy;
    changed output-busy=>{root.sites-updated();}
    callback output-idle;
    in property <bool> navigation-busy;
    in property <[SelectionRect]> navigation-rects;
    in property <int> pointer-cursor;
    in property <string> pointer-url;
    out property <bool> context-source-blocked: root.app-closing || root.sites-open || root.settings-open || root.editor-open || root.station-color-open || root.media-open || root.find-open || !root.native-foreground || root.native-composing
        || root.show-about || root.switching-station || root.frame-paint-pending
        || root.login-open || root.login-busy || root.paste-open || root.paste-reading || root.output-busy || root.tools-busy;
    out property <bool> terminal-pointer-blocked: root.context-source-blocked || root.context-open || root.context-pending;
    out property <bool> context-focus-restorable: !root.sites-open && !root.settings-open && !root.editor-open && !root.station-color-open && !root.media-open && root.native-foreground && !root.native-composing
        && !root.show-about && !root.switching-station && !root.login-open && !root.login-busy && !root.paste-open && !root.paste-reading;
    in property <bool> context-open;
    in property <bool> context-pending;
    in property <[MenuEntry]> context-entries;
    in property <int> context-selected;
    in property <length> context-x;
    in property <length> context-y;
    callback context-pointer(int,length,length);
    callback context-dismiss(bool);
    out property <length> terminal-origin-x: terminal-box.x;
    out property <length> terminal-origin-y: terminal-box.y;
    callback context-updated;
    callback context-key(int,bool);
    callback context-choose(int);
    callback focus-context;
    in-out property <bool> pan-mode;
    callback grid-pointer(int, length, length, bool);
    callback grid-wheel(float) -> bool;
    callback link-activated(string);
    in property <bool> station-mouse-available;
    in property <bool> station-mouse-enabled;
    in property <bool> station-mouse-held;
    in property <string> station-mouse-label;
    in property <string> station-mouse-status;
    out property <bool> station-pointer-blocked: root.app-closing || root.sites-open || root.settings-open || root.editor-open || root.station-color-open || root.media-open || root.find-open || !root.native-foreground || root.native-composing
        || root.show-about || root.switching-station || root.login-open || root.login-busy
        || root.paste-open || root.paste-reading || root.output-busy || root.pan-mode || root.context-open || root.context-pending || root.tools-busy;
    callback station-pointer(int, int, length, length, bool, bool, bool, bool) -> bool;
    callback station-wheel(length, length, float, bool, bool, bool, bool) -> bool;
    callback station-mouse-updated;
    callback station-mouse-cancel;
    callback toggle-station-mouse;
    callback clear-selection;
    callback copy-selection(bool);
    callback output-action(int);
    callback output-updated;
    callback output-geometry-changed;
    callback paste-updated;
    private property <length> physical-pixel: 1phx;
    private property <bool> show-about: false;
    private property <string> login-password;
    private property <bool> login-remember;
    private property <bool> pointer-shift;

    changed view-width => { root.context-updated();root.station-color-updated(); root.station-mouse-cancel(); root.geometry-changed(); root.article-layout-changed(); }
    changed view-height => { root.context-updated();root.station-color-updated(); root.station-mouse-cancel(); root.geometry-changed(); root.article-layout-changed(); }
    changed terminal-input-focused => { root.terminal-focus-changed(); }
    changed keep-alive-surface-ready => { root.keep-alive-changed(); }
    changed switching-station => {root.station-color-updated(); root.session-updated(); }
    changed zoom => {
        root.tools-cancel-gesture();
        root.station-mouse-cancel();
        viewport.content-x = 0px;
        viewport.content-y = 0px;
        root.geometry-changed();
        root.article-layout-changed();
    }
    changed article-blocked => { root.article-session-updated(); root.inline-updated(); }
    changed native-foreground => {root.station-color-updated(); root.article-session-updated(); root.inline-updated(); }
    changed physical-pixel => { root.tools-cancel-gesture(); root.station-mouse-cancel(); root.geometry-changed(); root.article-layout-changed(); }
    changed pan-mode => { root.station-mouse-cancel(); root.clear-selection(); }
    changed terminal-pointer-blocked => { root.output-updated(); }
    changed raster-left => { root.station-mouse-cancel(); root.clear-selection(); }
    changed raster-top => { root.station-mouse-cancel(); root.clear-selection(); }
    changed station-pointer-blocked => { root.station-mouse-updated(); }
    changed context-source-blocked => { root.context-updated();root.station-color-updated(); }

    FocusScope {
        width: parent.width;
        height: parent.height;
        visible: !root.media-open;
        capture-key-released(event) => {
            if event.text == Key.Return && root.inline-enter(false,event.repeat,!event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && !event.modifiers.shift) {return accept;}
            return reject;
        }
        capture-key-pressed(event) => {
            if event.text == Key.Return && root.inline-enter(true,event.repeat,!event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && !event.modifiers.shift) {return accept;}
            return reject;
        }
        key-pressed(event) => {
            if (event.text == Key.Escape && root.leave-fullscreen()) {
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.article-active ? UiLabels.article-heading : "PTTStella  /  80 × 24";
                    color: #e3e8ee;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button { text: "100%"; clicked => { root.zoom = 1; } }
                Button { text: "125%"; clicked => { root.zoom = 1.25; } }
                Button { text: "150%"; clicked => { root.zoom = 1.5; } }
                Button { text: UiLabels.fullscreen; clicked => { root.toggle-fullscreen(); } }
                if EditorState.available: Button {text:UiLabels.local-drafts;clicked=>{EditorState.action(0);} }
                if root.sites-available: Button {text:root.sites-label;clicked=>{root.sites-show();}}
                Button { text: UiLabels.about; clicked => { root.show-about = !root.show-about; } }
            }
            if root.media-available: HorizontalLayout {
                spacing:8px;
                Text {text:root.media-hover-help;color:#a7b6c8;overflow:elide;horizontal-stretch:1;vertical-alignment:center;}
                ComboBox {
                    preferred-width:120px;max-width:150px;
                    accessible-label:root.media-hover-label;model:root.media-hover-choices;
                    current-index <=> root.media-hover-choice;enabled:!root.output-busy;
                    selected(value)=>{root.media-hover-preference(self.current-index);}
                }
                if root.media-hover-choice != root.media-hover-position: Button {
                    text:root.media-retry-label;enabled:!root.output-busy;
                    clicked=>{root.media-hover-preference(root.media-hover-choice);}
                }
            }

            if root.media-available: HorizontalLayout {
                spacing:8px;
                CheckBox {
                    text:root.media-auto-label;checked <=> root.media-auto-choice;enabled:!root.output-busy;
                    toggled => {root.media-auto-preference(self.checked);}
                }
                Text {text:root.media-auto-help;color:#a7b6c8;overflow:elide;horizontal-stretch:1;vertical-alignment:center;}
                if root.media-auto-choice != root.media-auto-enabled: Button {
                    text:root.media-retry-label;enabled:!root.output-busy;
                    clicked=>{root.media-auto-preference(root.media-auto-choice);}
                }
            }

            terminal-box := Rectangle {
                vertical-stretch: 1;
                background: black;
                clip: true;
                viewport := Flickable {
                    visible: !root.article-active;
                    width: parent.width;
                    height: parent.height;
                    content-width: max(self.width, root.raster-width);
                    content-height: max(self.height, root.raster-height);
                    interactive: (!root.output-available || root.pan-mode) && (self.content-width > self.width || self.content-height > self.height);
                    raster := Image {
                        x: (viewport.content-width - self.width) / 2;
                        y: (viewport.content-height - self.height) / 2;
                        width: root.raster-width;
                        height: root.raster-height;
                        source: root.terminal-image;
                        image-fit: fill;
                    }
                    for span in root.selection-rects: Rectangle {
                        x: raster.x + span.x;
                        y: raster.y + span.y;
                        width: span.width;
                        height: span.height;
                        background: #4387d655;
                    }
                    for span in root.navigation-rects: Rectangle {
                        x: raster.x + span.x;
                        y: raster.y + span.y;
                        width: span.width;
                        height: span.height;
                        background: #4387d647;
                        border-color: #d9ae5b;
                        border-width: 1px;
                        Rectangle { width: 3px; height: parent.height; background: #d9ae5b; }
                        Rectangle { x: parent.width - 3px; width: 3px; height: parent.height; background: #d9ae5b; }
                    }
                    grid-input := TextInput {
                        enabled: !root.editor-open && !root.station-color-open;
                        visible: root.terminal-input;
                        accessible-label: UiLabels.terminal-input;
                        x: raster.x + root.caret-left;
                        y: raster.y + root.caret-top;
                        width: min(220px, viewport.content-width - self.x);
                        height: root.caret-height;
                        font-size: max(8px, root.caret-height * 0.85);
                        color: #e3e8ee;
                        text-cursor-width: root.live-session ? 0px : 1px;
                        single-line: true;
                        read-only: root.keyboard-read-only;
                    }
                    if root.terminal-input && !root.live-session && !root.terminal-input-focused: Rectangle {
                        x: grid-input.x;
                        y: grid-input.y + grid-input.height - 2px;
                        width: root.caret-height / 2;
                        height: 2px;
                        background: #53b7e8;
                    }
                }
                    TouchArea {
                        width: viewport.width;
                        height: viewport.height;
                        enabled: root.terminal-input && !root.pan-mode && !root.article-active;
                        mouse-cursor: root.selection-dragging ? MouseCursor.text :
                            root.pointer-cursor == 1 ? MouseCursor.pointer :
                            root.pointer-cursor == 2 ? MouseCursor.w-resize :
                            root.pointer-cursor == 3 ? MouseCursor.n-resize :
                            root.pointer-cursor == 4 ? MouseCursor.s-resize : MouseCursor.text;
                        changed has-hover => { if (!self.has-hover) { root.grid-pointer(5, self.mouse-x, self.mouse-y, false); } }
                        pointer-event(event) => {
                            root.pointer-shift = event.modifiers.shift;
                            let button = event.button == PointerEventButton.left ? 1 : event.button == PointerEventButton.middle ? 2 : event.button == PointerEventButton.right ? 3 : 0;
                            if (event.kind == PointerEventKind.cancel) {
                                root.context-pointer(3, self.mouse-x, self.mouse-y);
                                root.station-mouse-cancel();
                                root.grid-pointer(3, self.mouse-x, self.mouse-y, event.modifiers.shift);
                            } else if (event.kind == PointerEventKind.move) {
                                if (!root.station-pointer(1, 0, self.mouse-x, self.mouse-y, event.modifiers.shift, event.modifiers.alt, event.modifiers.control, event.modifiers.meta)) {
                                    root.grid-pointer(self.pressed ? 1 : 4, self.mouse-x, self.mouse-y, event.modifiers.shift);
                                }
                            } else if (event.kind == PointerEventKind.down) {
                                if (!root.station-pointer(0, button, self.mouse-x, self.mouse-y, event.modifiers.shift, event.modifiers.alt, event.modifiers.control, event.modifiers.meta)) {
                                    if (button == 1) { root.grid-pointer(0, self.mouse-x, self.mouse-y, event.modifiers.shift); }
                                    else if (button == 3) { root.context-pointer(0, self.mouse-x, self.mouse-y); }
                                }
                            } else if (event.kind == PointerEventKind.up) {
                                if (!root.station-pointer(2, button, self.mouse-x, self.mouse-y, event.modifiers.shift, event.modifiers.alt, event.modifiers.control, event.modifiers.meta)) {
                                    if (button == 1) { root.grid-pointer(2, self.mouse-x, self.mouse-y, event.modifiers.shift); }
                                    else if (button == 3) { root.context-pointer(2, self.mouse-x, self.mouse-y); }
                                }
                            }
                        }
                        double-clicked => { root.grid-pointer(6, self.mouse-x, self.mouse-y, root.pointer-shift); }
                        clicked => { grid-input.focus(); }
                        scroll-event(event) => {
                            if (root.terminal-pointer-blocked) { return reject; }
                            if (event.delta-y != 0px && !event.modifiers.meta && !event.modifiers.shift) {
                                if (event.modifiers.control) {
                                    root.zoom = clamp(root.zoom + (event.delta-y > 0px ? 0.25 : -0.25),0.25,4);
                                    return accept;
                                }
                                if (viewport.content-width > viewport.width || viewport.content-height > viewport.height) { return reject; }
                                if (root.station-wheel(self.mouse-x, self.mouse-y, event.delta-y / 1px, event.modifiers.shift, event.modifiers.alt, event.modifiers.control, event.modifiers.meta)) { return accept; }
                                if (!event.modifiers.alt && root.grid-wheel(event.delta-y / 1px)) { return accept; }
                            }
                            return reject;
                        }
                    }
                article-view := ArticleViewport {
                    visible: root.article-active;
                    width: parent.width; height: parent.height;
                    tiles: root.article-tiles; footer: root.article-footer;
                    inline-arrows:root.inline-arrows;inline-pictures:root.inline-pictures;inline-enabled:root.inline-enabled;
                    inline-pointer(kind,index,stamp)=>{root.inline-pointer(kind,index,stamp);}
                    inline-context(kind,index,stamp,x,y)=>{root.inline-context(kind,index,stamp,x,y);}
                    line-height: root.article-line-height; line-width: root.article-line-width;
                    body-height: root.article-body-height; document-height: root.article-document-height;
                    offset-y: root.article-offset-y; offset-x: root.article-offset-x;
                    blocked: root.article-blocked;
                    native-input: root.terminal-input;
                    composing: root.native-composing;
                    read-only: root.keyboard-read-only;
                    selection: root.selection-rects;
                    pointer-cursor: root.pointer-cursor;
                    pointer(kind,x,y,shift) => { root.pointer-shift = shift; root.grid-pointer(kind,x,y,shift); }
                    context-pointer(kind,x,y,shift) => { root.pointer-shift = shift; root.context-pointer(kind,x,y); }
                    layout-changed => { root.article-layout-changed(); }
                    scroll(delta,horizontal) => { root.article-scroll(delta,horizontal); }
                    navigate(code) => { root.article-navigate(code); }
                    scroll-to(vertical,fraction) => { root.article-scroll-to(vertical,fraction); }
                    zoom-request(delta) => { root.article-zoom-request(delta); }
                }
                if root.show-about: Rectangle {
                    width: 200px;
                    height: 96px;
                    background: #20252b;
                    AboutSlint {}
                }
                if root.pointer-url != "": Rectangle {
                    y: parent.height - 26px;
                    width: parent.width;
                    height: 26px;
                    background: #20252bee;
                    Text { text: root.pointer-url; color: #e3e8ee; overflow: elide; vertical-alignment: center; }
                }
                hover-card := MediaHover {
                    visible:root.media-hover-open;width:parent.width;height:parent.height;
                    pixels:root.media-image;ready:root.media-ready;status:root.media-status;
                    follow:root.media-hover-position==1;cursor-x:root.media-hover-x;cursor-y:root.media-hover-y;
                }
            }

            if root.article-load-available: HorizontalLayout {
                Text { text: root.article-load-status; color: #b7c1ce; horizontal-stretch: 1; vertical-alignment: center; }
                if root.article-load-active || root.article-load-can-resume: Button { text: root.article-load-active ? UiLabels.cancel-load : root.article-load-next-segment ? UiLabels.next-section : UiLabels.resume-load; clicked => { root.article-load-action(!root.article-load-active); } }
            }
            if root.article-station: Button { text: UiLabels.resume-reading; clicked => { root.article-resume-reading(); } }
            if !root.terminal-input && !root.session-active && !root.article-active: HorizontalLayout {
                spacing: 8px;
                compose := LineEdit {
                    placeholder-text: "在此測試繁中輸入法與貼上";
                    horizontal-stretch: 1;
                    accepted => { root.submit(self.text); }
                }
                Button { text: "驗證輸入"; clicked => { root.submit(compose.text); } }
            }
            if root.live-session: HorizontalLayout {
                spacing: 8px;
                selector := ComboBox {
                    model: root.stations;
                    current-index <=> root.station-choice;
                    enabled: !root.switching-station;
                }
                Button {
                    text: UiLabels.connect;
                    enabled: !root.switching-station && selector.current-index >= 0;
                    clicked => { root.switch-station(selector.current-index); }
                }
                Text {
                    text: root.session-warning;
                    color: #f0c987;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
            if root.output-available: HorizontalLayout {
                spacing: 8px;
                output-selector := ComboBox {
                    model: UiLabels.output-actions;
                    current-index <=> root.output-choice;
                    enabled: !root.output-busy;
                }
                Button { text: UiLabels.execute; enabled: !root.output-busy && (output-selector.current-index > 1 || root.selection-active) && ((output-selector.current-index != 3 && output-selector.current-index != 5) || root.selection-rows-ready); clicked => { root.output-action(output-selector.current-index); } }
                if !root.article-active: Button { text: root.pan-mode ? UiLabels.select-text : UiLabels.drag-scroll; clicked => { root.pan-mode = !root.pan-mode; } }
            }
            if root.terminal-input: HorizontalLayout {
                spacing: 8px;
                Button {
                    text: root.vim-label;
                    enabled: root.vim-available;
                    clicked => { root.toggle-vim(); }
                }
                if root.vim-enabled: Button {
                    text: root.vim-once-label;
                    enabled: root.vim-once-available;
                    clicked => { root.vim-once(); }
                }
                Text {
                    text: root.keyboard-label;
                    color: #f0c987;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            if root.station-mouse-available: HorizontalLayout {
                spacing: 8px;
                Button { text: root.station-mouse-label; clicked => { root.toggle-station-mouse(); } }
                Text { text: root.station-mouse-status; color: #b7c1ce; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.result;
                    color: #b7c1ce;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if root.input-notice != "": Text {
                    text: root.input-notice;
                    color: #f0c987;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if root.show-reconnect: Button {
                    text: UiLabels.reconnect;
                    enabled: root.can-reconnect;
                    clicked => { root.reconnect(); }
                }
                if root.keep-alive-available: Button {
                    text: root.keep-alive-label;
                    clicked => { root.toggle-keep-alive(); }
                }
                if root.login-available: Button {
                    text: root.login-label;
                    enabled: !root.login-busy;
                    clicked => { root.login-show(); }
                }
                if root.login-pending: Button {
                    text: root.login-cancel-attempt-label;
                    clicked => { root.login-cancel(); }
                }
            }
        }
    }
    tools-area := FloatingTools {
        visible: root.tools-available;
        width: root.width; height: root.height;
        opened: root.tools-open; dragging: root.tools-dragging;
        visible-ball: root.tools-visible || root.tools-open;
        blocked: root.tools-source-blocked;
        compact: root.tools-compact;
        ball-opacity: root.tools-opacity; scale: root.tools-scale;
        ball-x: root.tools-x; ball-y: root.tools-y;
        panel-x: root.tools-panel.x; panel-y: root.tools-panel.y;
        panel-width: root.tools-panel.width; panel-height: root.tools-panel.height;
        grid-height: root.tools-grid-height;
        category: root.tools-category; selected: root.tools-selected;
        categories: root.tools-categories; actions: root.tools-actions;
        title: root.tools-title; ball-label: root.tools-ball-label;
        ball-pointer(kind,x,y) => { root.tools-pointer(kind,x,y); }
        toggle => { root.tools-toggle(); }
        choose-category(index) => { root.tools-category-choose(index); }
        choose-action(index) => { root.tools-action-choose(index); }
        action-pointer(kind,index) => { root.tools-action-pointer(kind,index); }
        dismiss(focus) => { root.tools-dismiss(focus); }
        key(code,repeat) => { root.tools-key(code,repeat); }
    }
    focus-tools => { tools-area.focus-tools(); }
    context-area := ContextMenuOverlay {
        visible: root.context-open;
        width: root.width;
        height: root.height;
        entries: root.context-entries;
        selected: root.context-selected;
        anchor-x: terminal-box.x + root.context-x;
        anchor-y: terminal-box.y + root.context-y;
        choose(index) => { root.context-choose(index); }
        dismiss(focus) => { root.context-dismiss(focus); }
        key(code, repeat) => { root.context-key(code, repeat); }
    }
    focus-context => { context-area.focus-menu(); }

    Rectangle {
        visible: root.find-open;
        x: root.width - self.width - 12px;
        y: 44px;
        width: min(560px, root.width - 24px);
        height: 108px;
        background: #252d38;
        border-width: 1px;
        border-color: #67768b;
        border-radius: 6px;
        VerticalLayout {
            padding: 10px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 6px;
                find-input := LineEdit {
                    text <=> root.find-query;
                    placeholder-text: root.find-placeholder;
                    accessible-label: root.find-title;
                    horizontal-stretch: 1;
                    edited(text) => { root.find-edit(text); }
                    key-pressed(event) => {
                        if (!root.find-composing && !root.find-blocked) {
                            if (event.text == Key.Return) { root.find-action(event.modifiers.shift ? 1 : 2); return accept; }
                            if (event.text == Key.Escape) { root.find-action(3); return accept; }
                        }
                        return reject;
                    }
                }
                Button { text: "↑"; accessible-label: root.find-previous-label; enabled: root.find-has-matches; clicked => { root.find-action(1); } }
                Button { text: "↓"; accessible-label: root.find-next-label; enabled: root.find-has-matches; clicked => { root.find-action(2); } }
                Button { text: "×"; accessible-label: root.find-close-label; clicked => { root.find-action(3); } }
            }
            Text { text: root.find-status; color: #e3e8ee; }
            Text { text: root.find-hint; color: #b6c4d5; font-size: 11px; wrap: word-wrap; }
        }
    }

    focus-media => {media-preview.focus-preview();}
    media-preview := MediaPreview {
        x:0px;y:0px;width:root.width;height:root.height;visible:root.media-open;
        busy:root.output-busy;copy-label:root.media-copy-label;save-label:root.media-save-label;copy-url-label:root.media-copy-url-label;
        video:root.media-video;position:root.media-position;duration:root.media-duration;seek(value)=>{root.media-seek(value);}
        pixels:root.media-image;source-key:root.media-key;url:root.media-url;status:root.media-status;
        ready:root.media-ready;animated:root.media-animated;playing:root.media-playing;foreground:root.native-foreground;
        close-label:root.media-close-label;retry-label:root.media-retry-label;motion-label:root.media-motion-label;
        external-label:root.media-external-label;fit-label:root.media-fit-label;original-label:root.media-original-label;
        action(code)=>{root.media-action(code);}
    }

    show-login-popup => {
        root.login-password = "";
        root.login-remember = false;
        login-popup.show();
    }
    hide-login-popup(restore-focus) => {
        root.login-password = "";
        root.login-remember = false;
        login-popup.close();
        if (restore-focus) { root.focus-terminal(); }
    }
    clear-login-password => { root.login-password = ""; }
    login-popup := LoginPopup {
        width: min(600px, root.width - 24px);
        height: min(450px, root.height - 24px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        title: root.login-title;
        account-label: root.login-account-label;
        password-label: root.login-password-label;
        remember-label: root.login-remember-label;
        forget-label: root.login-forget-label;
        cancel-label: root.login-cancel-label;
        submit-label: root.login-label;
        message: root.login-message;
        account <=> root.login-account;
        password <=> root.login-password;
        remember <=> root.login-remember;
        busy: root.login-busy;
        saved: root.login-saved;
        submit(account, password, remember) => { root.login-submit(account, password, remember); }
        cancel => { root.login-cancel(); }
        forget => { root.login-forget(); }
        limit-text(text, maximum) => { return root.login-limit-text(text, maximum); }
    }

    show-paste-preview => { paste-dialog.show(); }
    focus-terminal => { if root.editor-open { root.focus-editor(); } else if root.article-active { root.focus-article(); } else if (root.terminal-input) { grid-input.focus(); } }
    hide-paste-preview(restore-focus) => {
        paste-dialog.close();
        if (restore-focus) { root.focus-terminal(); }
    }

    paste-dialog := PopupWindow {
        width: min(540px, root.width - 32px);
        height: min(380px, root.height - 32px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        close-policy: PopupClosePolicy.no-auto-close;
        forward-focus: cancel-paste;

        FocusScope {
            width: parent.width;
            height: parent.height;
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.paste-cancel();
                    return accept;
                }
                return reject;
            }
            Rectangle {
                width: parent.width;
                height: parent.height;
                background: #20252b;
                border-radius: 6px;
                border-width: 1px;
                border-color: #6d7b87;
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text {
                        text: root.paste-title;
                        color: #e3e8ee;
                        font-weight: 700;
                    }
                    TextEdit {
                        text: root.paste-preview;
                        accessible-label: root.paste-title;
                        read-only: true;
                        vertical-stretch: 1;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        cancel-paste := Button {
                            text: root.paste-cancel-label;
                            clicked => { root.paste-cancel(); }
                        }
                        Button {
                            text: root.paste-send-label;
                            clicked => { root.paste-confirm(); }
                        }
                    }
                }
            }
        }
    }
    editor-view := NativeEditor { visible:EditorState.open; width:parent.width;height:parent.height; }
    station-color-view := StationColor {visible:StationColorState.open;width:root.width;height:root.height;}

}
